/glpi_data/plugins/ativawallpaper/deployment/unified-installer/dist/
/glpi_data/plugins/ativawallpaper/client/dist/
/glpi_data/plugins/ativawallpaper/client/build/
/glpi_data/plugins/ativawallpaper/client/.venv-build/

