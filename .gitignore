# Runtime data must never be versioned. Git cannot create a consistent backup
# of a live MySQL data directory and may corrupt InnoDB files during a pull.
/mysql_data/

# Local credentials and generated backups.
/.env
/*.sql
/*.sql.gz
/*.sha256
/backups/

# Ativa Wallpaper build secrets and generated binaries.
/glpi_data/plugins/ativawallpaper/deployment/unified-installer/bootstrap-config.json
/glpi_data/plugins/ativawallpaper/deployment/unified-installer/dist/
/glpi_data/plugins/ativawallpaper/client/dist/
/glpi_data/plugins/ativawallpaper/client/build/
/glpi_data/plugins/ativawallpaper/client/.venv-build/

# Ativa Updater / Workspace: saidas do PyInstaller (geradas no build).
/glpi_data/plugins/ativaupdater/client/build/
/glpi_data/plugins/ativaupdater/client/dist/
/glpi_data/plugins/ativaworkspace/client/build/
/glpi_data/plugins/ativaworkspace/client/dist/


# graphify knowledge-graph outputs and extraction caches. Generated artifacts,
# regenerable with /graphify. The pattern is unanchored so it matches the
# directory at any depth, not just the repo root.
graphify-out/
glpi_data/plugins/meshcentral
# Plugin MeshCentral: mantido apenas no disco, fora do versionamento.
# Era um gitlink de submodulo sem .gitmodules, entao seu conteudo nunca esteve
# de fato neste repositorio. Contem patches locais de compatibilidade (GLPI 11)
# que existem somente na copia de trabalho.
/glpi_data/plugins/meshcentral/
