# Runtime data must never be versioned. Git cannot create a consistent backup
# of a live MySQL data directory and may corrupt InnoDB files during a pull.
/mysql_data/

# Local credentials and generated backups.
/.env
/*.sql
/*.sql.gz
/*.sha256
/backups/

