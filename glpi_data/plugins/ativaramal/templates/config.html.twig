{% set s = status %}
{% set connected = s.has_access_token and not s.token_expired %}
<div class="row">
    <div class="col-12 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-3">
            <span class="avatar avatar-md bg-primary-lt"><i class="ti ti-phone fs-2"></i></span>
            <div>
                <h2 class="mb-0">Ativa Ramal</h2>
                <div class="text-muted">Integração da telefonia com a TW Solutions</div>
            </div>
        </div>
        {% if connected %}
            <span class="badge bg-green-lt fs-5"><i class="ti ti-plug-connected me-1"></i>Conectado à TW Solutions</span>
        {% elseif s.has_access_token %}
            <span class="badge bg-yellow-lt fs-5"><i class="ti ti-clock-exclamation me-1"></i>Token expirado</span>
        {% else %}
            <span class="badge bg-secondary-lt fs-5"><i class="ti ti-plug-x me-1"></i>Não conectado</span>
        {% endif %}
    </div>

    {% if not s.glpi_https %}
        <div class="col-12">
            <div class="alert alert-danger">
                <i class="ti ti-alert-triangle me-1"></i>
                A <strong>URL da aplicação</strong> do GLPI (Configurar &gt; Geral) não é HTTPS. O callback OAuth exige HTTPS.
            </div>
        </div>
    {% endif %}
    {% if not s.encryption_ready %}
        <div class="col-12">
            <div class="alert alert-danger">
                <i class="ti ti-key-off me-1"></i>
                O GLPI não conseguiu ler a chave criptográfica (glpicrypt.key). Os segredos não podem ser salvos até corrigir isso.
            </div>
        </div>
    {% endif %}

    {# ------------------------------------------------ Credenciais #}
    <div class="col-12 col-xl-7 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-key me-2 text-primary"></i>Credenciais da TW Solutions</h3>
            </div>
            <form method="post" action="{{ action_url }}" autocomplete="off">
                <div class="card-body">
                    <fieldset {{ can_edit ? '' : 'disabled' }}>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label" for="ar-base-url">URL base da API</label>
                                <input type="url" class="form-control" id="ar-base-url" name="base_url" value="{{ s.base_url }}"
                                       placeholder="https://ativa-locacao-1.twsolutions.com.br" pattern="https://.*">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="ar-authorize-url">URL de autorização (OAuth)</label>
                                <input type="url" class="form-control" id="ar-authorize-url" name="authorize_url" value="{{ s.authorize_url }}"
                                       placeholder="{{ s.base_url ? s.base_url ~ '/oauth/authorize' : 'padrão: {URL base}/oauth/authorize' }}" pattern="https://.*">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="ar-token-url">URL do token (OAuth)</label>
                                <input type="url" class="form-control" id="ar-token-url" name="token_url" value="{{ s.token_url }}"
                                       placeholder="{{ s.base_url ? s.base_url ~ '/oauth/token' : 'padrão: {URL base}/oauth/token' }}" pattern="https://.*">
                            </div>
                            <div class="col-12 form-hint mt-0">Deixe as duas URLs OAuth em branco para usar o padrão a partir da URL base; preencha se a documentação da TW indicar outras.</div>
                            <div class="col-md-6">
                                <label class="form-label" for="ar-client-id">Client ID</label>
                                <input type="text" class="form-control" id="ar-client-id" name="client_id" value="{{ s.client_id }}" maxlength="255">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="ar-scope">Escopos (opcional)</label>
                                <input type="text" class="form-control" id="ar-scope" name="scope" value="{{ s.scope }}" maxlength="255" placeholder="separados por espaço">
                            </div>

                            {% for key, label in {'client_secret': 'Client Secret', 'access_token': 'Access Token', 'refresh_token': 'Refresh Token', 'api_token': 'Token da API (painel TW)', 'api_key': 'Key da API (painel TW)'} %}
                                {% set stored = s['has_' ~ key] %}
                                <div class="col-md-{{ key == 'client_secret' ? 12 : 6 }}">
                                    <label class="form-label" for="ar-{{ key }}">
                                        {{ label }}
                                        {% if stored %}<span class="badge bg-green-lt ms-1"><i class="ti ti-lock me-1"></i>salvo</span>{% else %}<span class="badge bg-secondary-lt ms-1">vazio</span>{% endif %}
                                    </label>
                                    <input type="password" class="form-control font-monospace" id="ar-{{ key }}" name="{{ key }}" value=""
                                           autocomplete="new-password" spellcheck="false"
                                           placeholder="{{ stored ? '•••••••• (deixe em branco para manter)' : (key == 'client_secret' ? 'Cole o Client Secret' : (key starts with 'api_' ? 'Cole o valor gerado no painel da TW' : 'Preenchido ao conectar (ou cole aqui)')) }}">
                                    {% if stored %}
                                        <label class="form-check mt-1 mb-0">
                                            <input class="form-check-input" type="checkbox" name="clear_{{ key }}" value="1">
                                            <span class="form-check-label small text-muted">Remover o valor salvo</span>
                                        </label>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </fieldset>
                    <div class="form-hint mt-3">
                        <i class="ti ti-shield-lock me-1"></i>Segredos e tokens são criptografados pelo GLPI (glpicrypt.key), nunca são exibidos de volta e não vão para os logs.
                    </div>
                </div>
                {% if can_edit %}
                    <div class="card-footer text-end">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="action" value="save">
                        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Salvar</button>
                    </div>
                {% endif %}
            </form>
        </div>
    </div>

    {# ------------------------------------------------ OAuth #}
    <div class="col-12 col-xl-5 mb-3">
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-plug-connected me-2 text-primary"></i>Conexão OAuth</h3>
            </div>
            <div class="card-body">
                <label class="form-label">Redirect URL (cadastrar na TW Solutions)</label>
                <div class="input-group mb-3">
                    <input type="text" class="form-control font-monospace small" readonly value="{{ s.redirect_uri }}" data-ar-copy-src="redirect">
                    <button class="btn btn-outline-secondary" type="button" data-ar-copy="redirect" title="Copiar"><i class="ti ti-copy"></i></button>
                </div>
                <dl class="row mb-0 small">
                    <dt class="col-6 text-muted fw-normal">Token de acesso</dt>
                    <dd class="col-6">{{ s.has_access_token ? (s.token_expired ? 'expirado' : 'ativo') : '—' }}</dd>
                    <dt class="col-6 text-muted fw-normal">Expira em</dt>
                    <dd class="col-6">{{ s.token_expires_at ? s.token_expires_at|date('d/m/Y H:i') : (s.has_access_token ? 'não informado' : '—') }}</dd>
                    <dt class="col-6 text-muted fw-normal">Refresh token</dt>
                    <dd class="col-6">{{ s.has_refresh_token ? 'salvo' : '—' }}</dd>
                    <dt class="col-6 text-muted fw-normal">Última renovação</dt>
                    <dd class="col-6">{{ s.last_refresh_at ? s.last_refresh_at|date('d/m/Y H:i') : '—' }}</dd>
                </dl>
                {% if s.last_refresh_error %}
                    <div class="alert alert-warning mt-3 mb-0 small"><i class="ti ti-alert-triangle me-1"></i>{{ s.last_refresh_error }}</div>
                {% endif %}
                <div class="form-hint mt-2">Renovação automática: tarefa "RefreshToken" a cada 5 minutos, quando faltam menos de 10 minutos para expirar.</div>
            </div>
            {% if can_edit %}
                <div class="card-footer d-flex flex-wrap gap-2">
                    <form method="post" action="{{ action_url }}">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="action" value="connect">
                        <button type="submit" class="btn btn-primary" {{ s.client_id and s.has_client_secret and s.effective_authorize_url ? '' : 'disabled' }}
                                title="Abre a tela de autorização da TW Solutions">
                            <i class="ti ti-login me-1"></i>{{ s.has_access_token ? 'Reconectar' : 'Conectar com a TW Solutions' }}
                        </button>
                    </form>
                    {% if s.has_refresh_token %}
                        <form method="post" action="{{ action_url }}">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="action" value="refresh">
                            <button type="submit" class="btn btn-outline-secondary"><i class="ti ti-refresh me-1"></i>Renovar agora</button>
                        </form>
                    {% endif %}
                    {% if s.has_access_token or s.has_refresh_token %}
                        <form method="post" action="{{ action_url }}" onsubmit="return confirm('Apagar o access token e o refresh token?');">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="action" value="disconnect">
                            <button type="submit" class="btn btn-outline-danger"><i class="ti ti-plug-x me-1"></i>Desconectar</button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        {# ------------------------------------------------ Webhook #}
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="ti ti-webhook me-2 text-primary"></i>Webhook</h3>
            </div>
            <div class="card-body">
                <label class="form-label">URL do webhook</label>
                <div class="input-group mb-2">
                    <input type="text" class="form-control font-monospace small" readonly value="{{ s.webhook_url }}" data-ar-copy-src="webhook">
                    <button class="btn btn-outline-secondary" type="button" data-ar-copy="webhook" title="Copiar"><i class="ti ti-copy"></i></button>
                </div>
                {% if can_edit and webhook_token %}
                    <label class="form-label">Token do webhook</label>
                    <div class="input-group mb-2">
                        <input type="password" class="form-control font-monospace small" readonly value="{{ webhook_token }}" data-ar-copy-src="token">
                        <button class="btn btn-outline-secondary" type="button" data-ar-show="token" title="Mostrar"><i class="ti ti-eye"></i></button>
                        <button class="btn btn-outline-secondary" type="button" data-ar-copy="token" title="Copiar"><i class="ti ti-copy"></i></button>
                    </div>
                {% endif %}
                <div class="form-hint">
                    Enviar no cabeçalho <code>X-Ativa-Token</code> (ou <code>Authorization: Bearer</code>). Se a TW só aceitar URL,
                    use <code>?token=…</code>. Nesta etapa os eventos são só validados e registrados.
                </div>
                <div class="small text-muted mt-2">Último evento recebido: {{ s.webhook_last_at ? s.webhook_last_at|date('d/m/Y H:i') : 'nenhum' }}</div>
            </div>
            {% if can_edit %}
                <div class="card-footer text-end">
                    <form method="post" action="{{ action_url }}" onsubmit="return confirm('Gerar um novo token? O atual para de funcionar na hora.');">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="action" value="regenerate_webhook">
                        <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="ti ti-refresh me-1"></i>Gerar novo token</button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
    {# ------------------------------------------------ Diagnostico da API #}
    {% if can_edit %}
    <div class="col-12 mb-3">
        <div class="card" data-ar-diag data-url="{{ diag_url }}" data-groups="{{ diag_groups|json_encode|e('html_attr') }}"
             data-schemes="{{ apikey_schemes|json_encode|e('html_attr') }}">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h3 class="card-title mb-0"><i class="ti ti-stethoscope me-2 text-primary"></i>Diagnóstico da API</h3>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary" data-ar-diag-run {{ connected and s.base_url ? '' : 'disabled' }}>
                        <i class="ti ti-player-play me-1"></i>Testar API da TW
                    </button>
                    <button type="button" class="btn btn-success" data-ar-diag-run-apikey {{ s.has_api_token and s.has_api_key and s.base_url ? '' : 'disabled' }}
                            title="Usa o Token + Key criados no painel da TW (Ferramentas)">
                        <i class="ti ti-key me-1"></i>Testar com Token/Key
                    </button>
                    <button type="button" class="btn btn-outline-primary" data-ar-diag-run-client {{ s.client_id and s.has_client_secret and s.base_url ? '' : 'disabled' }}
                            title="Pede um token de sistema (client credentials) só para este teste; não é salvo e não muda a conexão">
                        <i class="ti ti-robot me-1"></i>Testar com token de sistema
                    </button>
                    <button type="button" class="btn btn-outline-secondary d-none" data-ar-diag-copy>
                        <i class="ti ti-copy me-1"></i>Copiar relatório
                    </button>
                </div>
            </div>
            <div class="card-body">
                {% if not connected %}
                    <div class="alert alert-warning"><i class="ti ti-plug-x me-1"></i>Conecte à TW Solutions (token válido) para testar.</div>
                {% endif %}
                <p class="text-muted mb-2">
                    Faz requisições <strong>GET</strong> autenticadas (somente leitura) em <code>{{ s.base_url ?: '(URL base)' }}</code> e mostra,
                    para cada URL, o código HTTP, o tempo e a resposta, com tokens e segredos ocultos.
                </p>
                <div class="alert alert-info small">
                    <i class="ti ti-info-circle me-1"></i>
                    A TW não publica a documentação da API. {{ diag_note }}
                    Para outros caminhos (ex.: os que a TW informar), use o campo "Caminho personalizado".
                </div>
                <details class="mb-3">
                    <summary class="text-muted small" style="cursor:pointer">Ver as URLs que serão testadas</summary>
                    <div class="row mt-2">
                        {% for key, group in diag_groups %}
                            <div class="col-md-6 col-xl mb-2">
                                <div class="small fw-semibold">{{ group.label }}</div>
                                {% for path in group.paths %}
                                    <div class="font-monospace small text-muted text-break">{{ s.base_url }}{{ path }}</div>
                                {% endfor %}
                            </div>
                        {% endfor %}
                    </div>
                </details>
                <form class="input-group mb-3" data-ar-diag-custom autocomplete="off">
                    <span class="input-group-text font-monospace small text-truncate" style="max-width:45%">{{ s.base_url ?: '(URL base)' }}</span>
                    <input type="text" class="form-control font-monospace" name="path" placeholder="/caminho?parametro=valor" maxlength="300" aria-label="Caminho personalizado">
                    <button type="submit" class="btn btn-outline-primary" {{ connected and s.base_url ? '' : 'disabled' }}><i class="ti ti-send me-1"></i>Testar caminho</button>
                </form>
                <div class="d-none mb-2 small text-muted" data-ar-diag-progress></div>
                <div data-ar-diag-results></div>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<script>
(function () {
    document.querySelectorAll('[data-ar-copy]').forEach(function (button) {
        button.addEventListener('click', function () {
            var input = document.querySelector('[data-ar-copy-src="' + button.dataset.arCopy + '"]');
            if (!input) { return; }
            var done = function () {
                button.innerHTML = '<i class="ti ti-check"></i>';
                setTimeout(function () { button.innerHTML = '<i class="ti ti-copy"></i>'; }, 1500);
            };
            (navigator.clipboard ? navigator.clipboard.writeText(input.value) : Promise.reject()).then(done, function () {
                input.type = 'text'; input.select(); document.execCommand('copy'); done();
            });
        });
    });
    document.querySelectorAll('[data-ar-show]').forEach(function (button) {
        button.addEventListener('click', function () {
            var input = document.querySelector('[data-ar-copy-src="' + button.dataset.arShow + '"]');
            if (input) { input.type = input.type === 'password' ? 'text' : 'password'; }
        });
    });
})();
</script>

<script>
(function () {
    // Diagnostico da API: um caminho por vez, resultado aparecendo na hora.
    var card = document.querySelector('[data-ar-diag]');
    if (!card) { return; }
    var url = card.dataset.url;
    var groups = JSON.parse(card.dataset.groups || '{}');
    var results = card.querySelector('[data-ar-diag-results]');
    var progress = card.querySelector('[data-ar-diag-progress]');
    var runBtn = card.querySelector('[data-ar-diag-run]');
    var copyBtn = card.querySelector('[data-ar-diag-copy]');
    var csrf = (document.querySelector('meta[property="glpi:csrf_token"]') || {}).content || '';
    var report = [];
    var running = false;

    function el(tag, cls, text) {
        var n = document.createElement(tag);
        if (cls) { n.className = cls; }
        if (text !== undefined && text !== null) { n.textContent = text; }
        return n;
    }
    function badgeClass(status) {
        if (status >= 200 && status < 300) { return 'bg-green'; }
        if (status >= 300 && status < 400) { return 'bg-blue'; }
        if (status === 401 || status === 403) { return 'bg-yellow'; }
        if (status === 404 || status === 405) { return 'bg-secondary'; }
        return 'bg-red';
    }
    function meaning(r) {
        if (r.error) { return r.error; }
        var s = r.status;
        if (s >= 200 && s < 300) { return r.json ? 'Respondeu com JSON' : 'Respondeu (não é JSON)'; }
        if (s >= 300 && s < 400) { return 'Redireciona' + (r.location ? ' para ' + r.location : ''); }
        if (s === 401) { return 'Token recusado / sem autenticação para este caminho'; }
        if (s === 403) { return 'Sem permissão (escopo) para este caminho'; }
        if (s === 404) { return 'Não existe'; }
        if (s === 405) { return 'Existe, mas não aceita GET'; }
        if (s === 422 || s === 400) { return 'Existe, mas faltam parâmetros'; }
        return 'Erro do servidor';
    }

    function call(path, mode, scheme) {
        var body = new FormData();
        body.append('path', path);
        body.append('mode', mode || 'user');
        if (scheme) { body.append('scheme', scheme); }
        return fetch(url, { method: 'POST', body: body, credentials: 'same-origin',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-Glpi-Csrf-Token': csrf } })
            .then(function (resp) { return resp.json().catch(function () { return { ok: false, message: 'Erro ' + resp.status + ' no GLPI.' }; }); })
            .catch(function () { return { ok: false, message: 'Falha de comunicação com o GLPI.' }; });
    }

    function render(container, path, data) {
        var item = el('div', 'border rounded mb-2');
        var head = el('div', 'd-flex flex-wrap align-items-center gap-2 p-2');
        if (!data.ok) {
            head.appendChild(el('span', 'badge bg-red', 'erro'));
            head.appendChild(el('span', 'font-monospace small', path || '/'));
            head.appendChild(el('span', 'small text-danger', data.message || 'Falhou.'));
            item.appendChild(head);
            container.appendChild(item);
            report.push('[erro] ' + (path || '/') + ' - ' + (data.message || ''));
            return;
        }
        var r = data.result;
        head.appendChild(el('span', 'badge ' + badgeClass(r.status) + ' text-white', r.status ? String(r.status) : '—'));
        head.appendChild(el('span', 'font-monospace small text-break', 'GET ' + r.url));
        if (r.mode === 'client') { head.appendChild(el('span', 'badge bg-purple-lt', 'token de sistema')); }
        if (r.mode === 'apikey') { head.appendChild(el('span', 'badge bg-green-lt', 'Token/Key: ' + r.scheme_label)); }
        head.appendChild(el('span', 'small text-muted', meaning(r) + ' · ' + r.ms + ' ms · ' + r.bytes + ' bytes' + (r.content_type ? ' · ' + r.content_type : '')));
        item.appendChild(head);
        report.push(['[' + (r.status || 'sem resposta') + ']', 'GET ' + r.url, '-', meaning(r), '(' + r.ms + ' ms)',
            r.mode === 'client' ? '[token de sistema]' : (r.mode === 'apikey' ? '[Token/Key: ' + r.scheme_label + ']' : '')].join(' '));

        var hasDetails = r.preview || (r.fields && r.fields.length) || (r.headers && Object.keys(r.headers).length);
        if (hasDetails) {
            var det = el('details', 'px-2 pb-2');
            det.open = r.status >= 200 && r.status < 300;
            det.appendChild(el('summary', 'small text-muted', 'Detalhes da resposta'));
            if (r.fields && r.fields.length) {
                det.appendChild(el('div', 'small fw-semibold mt-2', 'Campos encontrados'));
                var table = el('table', 'table table-sm small mb-2');
                var tbody = el('tbody');
                r.fields.forEach(function (f) {
                    var tr = el('tr');
                    tr.appendChild(el('td', 'font-monospace', f.path));
                    tr.appendChild(el('td', 'text-muted', f.type));
                    tr.appendChild(el('td', 'text-muted text-break', f.example));
                    tbody.appendChild(tr);
                    report.push('    campo ' + f.path + ' (' + f.type + ')');
                });
                table.appendChild(tbody);
                det.appendChild(table);
            }
            if (r.headers && Object.keys(r.headers).length) {
                det.appendChild(el('div', 'small fw-semibold', 'Cabeçalhos relevantes'));
                Object.keys(r.headers).forEach(function (h) {
                    det.appendChild(el('div', 'font-monospace small text-muted', h + ': ' + r.headers[h]));
                });
            }
            if (r.preview) {
                det.appendChild(el('div', 'small fw-semibold mt-2', 'Resposta' + (r.truncated ? ' (cortada)' : '')));
                det.appendChild(el('pre', 'small bg-light p-2 mb-0', r.preview)).style.maxHeight = '320px';
            }
            item.appendChild(det);
        }
        container.appendChild(item);
    }

    function runList(list, onDone) {
        running = true;
        runBtn.disabled = true;
        progress.classList.remove('d-none');
        var i = 0;
        function next() {
            if (i >= list.length) {
                running = false;
                runBtn.disabled = false;
                progress.textContent = 'Concluído: ' + list.length + ' URL(s) testada(s).';
                copyBtn.classList.remove('d-none');
                if (onDone) { onDone(); }
                return;
            }
            var job = list[i++];
            progress.textContent = 'Testando ' + i + ' de ' + list.length + ': ' + (job.path || '/');
            call(job.path, job.mode, job.scheme).then(function (data) {
                render(job.box, job.path, data);
                if (job.onResult) { job.onResult(data); }
                next();
            });
        }
        next();
    }

    function runAll(mode, scheme) {
        if (running) { return; }
        results.innerHTML = '';
        report = ['Diagnóstico da API da TW Solutions - ' + new Date().toLocaleString('pt-BR')
            + (mode === 'client' ? ' (token de sistema / client credentials)' : ' (token da conexão OAuth)')];
        var list = [];
        Object.keys(groups).forEach(function (key) {
            var section = el('div', 'mb-3');
            section.appendChild(el('h4', 'mb-2', groups[key].label));
            results.appendChild(section);
            groups[key].paths.forEach(function (path) { list.push({ path: path, box: section, mode: mode, scheme: scheme }); });
        });
        report.push('');
        runList(list);
    }
    runBtn.addEventListener('click', function () { runAll('user'); });
    var runClientBtn = card.querySelector('[data-ar-diag-run-client]');
    if (runClientBtn) { runClientBtn.addEventListener('click', function () { runAll('client'); }); }

    // Token/Key: 1) testa /api/v1/ramal em cada forma de envio; 2) com a
    // primeira que nao for recusada (401/403), testa todas as rotas.
    var schemes = JSON.parse(card.dataset.schemes || '{}');
    var runKeyBtn = card.querySelector('[data-ar-diag-run-apikey]');
    if (runKeyBtn) {
        runKeyBtn.addEventListener('click', function () {
            if (running) { return; }
            results.innerHTML = '';
            report = ['Diagnóstico da API da TW Solutions - ' + new Date().toLocaleString('pt-BR') + ' (Token/Key do painel)', '', 'Formas de envio:'];
            var section = el('div', 'mb-3');
            section.appendChild(el('h4', 'mb-2', 'Formas de envio do Token/Key (em /api/v1/ramal)'));
            results.appendChild(section);
            var accepted = '';
            var list = Object.keys(schemes).map(function (scheme) {
                return { path: '/api/v1/ramal', box: section, mode: 'apikey', scheme: scheme, onResult: function (data) {
                    var st = data.ok ? data.result.status : 0;
                    if (!accepted && st && st !== 401 && st !== 403) { accepted = scheme; }
                } };
            });
            runList(list, function () {
                if (!accepted) {
                    section.appendChild(el('div', 'alert alert-warning small', 'Nenhuma forma de envio foi aceita (todas 401/403). Peça à TW como enviar o Token e a Key nas requisições.'));
                    report.push('', 'Nenhuma forma de envio aceita.');
                    return;
                }
                section.appendChild(el('div', 'alert alert-success small', 'Aceita: ' + schemes[accepted] + '. Testando todas as rotas com ela…'));
                report.push('', 'Forma aceita: ' + schemes[accepted], '');
                var full = [];
                Object.keys(groups).forEach(function (key) {
                    var box = el('div', 'mb-3');
                    box.appendChild(el('h4', 'mb-2', groups[key].label));
                    results.appendChild(box);
                    groups[key].paths.forEach(function (path) { full.push({ path: path, box: box, mode: 'apikey', scheme: accepted }); });
                });
                runList(full);
            });
        });
    }

    card.querySelector('[data-ar-diag-custom]').addEventListener('submit', function (event) {
        event.preventDefault();
        if (running) { return; }
        var input = event.target.querySelector('[name="path"]');
        var section = el('div', 'mb-3');
        section.appendChild(el('h4', 'mb-2', 'Caminho personalizado'));
        results.insertBefore(section, results.firstChild);
        if (!report.length) { report = ['Diagnóstico da API da TW Solutions - ' + new Date().toLocaleString('pt-BR')]; }
        runList([{ path: input.value.trim(), box: section }]);
    });

    copyBtn.addEventListener('click', function () {
        var text = report.join('\n');
        var done = function () {
            copyBtn.innerHTML = '<i class="ti ti-check me-1"></i>Copiado';
            setTimeout(function () { copyBtn.innerHTML = '<i class="ti ti-copy me-1"></i>Copiar relatório'; }, 1500);
        };
        (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject()).then(done, function () { window.prompt('Copie o relatório:', text); });
    });
})();
</script>
