<link rel="stylesheet" href="{{ css_url }}">

{% macro when(value, today) -%}
    {%- if value is empty -%}—
    {%- elseif value starts with today -%}hoje {{ value|slice(11) }}
    {%- else -%}{{ value }}{%- endif -%}
{%- endmacro %}
{% import _self as fmt %}

<div class="ar-app ar-equip" id="ar-equip">
    <div class="ar-head">
        <div>
            <h2 class="mb-1"><i class="ti ti-devices me-2 text-primary"></i>Equipamentos</h2>
            <div class="text-muted small">Quem usa cada máquina, onde ela está (mesa e porta do switch) e os monitores ligados nela, pelo Ativa Guardian.</div>
        </div>
    </div>

    {# Resumo: cada bloco tambem filtra a lista de maquinas. #}
    <div class="ar-eq-stats">
        <button type="button" class="ar-eq-stat" data-ar-state="">
            <span class="ar-eq-stat-icon"><i class="ti ti-device-desktop"></i></span>
            <span><strong>{{ machines|length }}</strong><small>Máquinas</small></span>
        </button>
        <button type="button" class="ar-eq-stat is-green" data-ar-state="online">
            <span class="ar-eq-stat-icon"><i class="ti ti-plug-connected"></i></span>
            <span><strong>{{ counts.online }}</strong><small>Ligadas agora</small></span>
        </button>
        <button type="button" class="ar-eq-stat is-gray" data-ar-state="offline">
            <span class="ar-eq-stat-icon"><i class="ti ti-plug-connected-x"></i></span>
            <span><strong>{{ counts.offline }}</strong><small>Sem contato</small></span>
        </button>
        <button type="button" class="ar-eq-stat is-blue" data-ar-state="nodesk">
            <span class="ar-eq-stat-icon"><i class="ti ti-layout-board"></i></span>
            <span><strong>{{ counts.nodesk }}</strong><small>Sem mesa na planta</small></span>
        </button>
        <button type="button" class="ar-eq-stat is-orange" data-ar-state="diagnostic">
            <span class="ar-eq-stat-icon"><i class="ti ti-alert-circle"></i></span>
            <span><strong>{{ counts.diagnostic }}</strong><small>Coleta incompleta</small></span>
        </button>
    </div>

    <div class="card ar-eq-card">
        <div class="card-header ar-eq-tabs-head">
            <ul class="nav nav-tabs card-header-tabs" role="tablist" data-ar-tabs>
                <li class="nav-item"><a class="nav-link active" href="#maquinas" data-ar-tab="maquinas" role="tab"><i class="ti ti-users me-1"></i>Máquinas <span class="badge bg-secondary-lt ms-1">{{ machines|length }}</span></a></li>
                {% if missing|length %}
                    <li class="nav-item"><a class="nav-link" href="#missing" data-ar-tab="missing" role="tab"><i class="ti ti-alert-triangle me-1 text-warning"></i>Sem posição <span class="badge bg-warning-lt ms-1">{{ missing|length }}</span></a></li>
                {% endif %}
                <li class="nav-item"><a class="nav-link" href="#monitores" data-ar-tab="monitores" role="tab"><i class="ti ti-device-desktop-analytics me-1"></i>Monitores <span class="badge bg-secondary-lt ms-1">{{ monitors|length }}</span></a></li>
                <li class="nav-item"><a class="nav-link" href="#switches" data-ar-tab="switches" role="tab"><i class="ti ti-network me-1"></i>Switches <span class="badge bg-secondary-lt ms-1">{{ switches|length }}</span></a></li>
            </ul>
        </div>

        {# ------------------------------------------------------------ Maquinas #}
        <div class="ar-eq-pane" data-ar-pane="maquinas">
            <div class="ar-eq-toolbar">
                <div class="input-icon ar-eq-search">
                    <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                    <input type="search" class="form-control" data-ar-search placeholder="Buscar pessoa, máquina, mesa, IP ou monitor..." aria-label="Buscar">
                </div>
                <div class="ar-eq-chips" data-ar-branches role="group" aria-label="Filial">
                    <button type="button" class="ar-chip is-active" data-ar-branch=""><i class="ti ti-building-community"></i><span>Todas as filiais</span><strong>{{ machines|length }}</strong></button>
                    {% for b in branches %}
                        <button type="button" class="ar-chip" data-ar-branch="{{ b.key }}"><span>{{ b.name ?: 'Sem filial' }}</span><strong>{{ b.machines|length }}</strong></button>
                    {% endfor %}
                </div>
                {% if can_manage %}
                    <button type="button" class="btn btn-sm btn-ghost-secondary ms-auto" data-ar-toggle="#ar-branch-rules" title="Qual rede é de qual filial">
                        <i class="ti ti-settings me-1"></i>Filiais por rede
                    </button>
                {% endif %}
            </div>

            {% if can_manage %}
                <div class="ar-eq-rules" id="ar-branch-rules" hidden>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h4 class="mb-0 d-flex align-items-center"><i class="ti ti-network me-2 text-primary"></i>Filiais por rede</h4>
                            <div class="text-muted small">
                                Identifique a filial de cada roteador pelo MAC físico. Como Limeira, Campo Grande e Londrina usam a mesma faixa de IP (<code>192.168.0.1</code>), o MAC do roteador garante que cada máquina fique na sua filial correta.
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-ar-toggle="#ar-branch-rules" title="Fechar painel"><i class="ti ti-x"></i></button>
                    </div>

                    <div class="table-responsive mb-3">
                        <table class="table table-vcenter card-table table-striped table-hover bg-white border rounded">
                            <thead>
                                <tr>
                                    <th>Rede (gateway)</th>
                                    <th>MAC do roteador</th>
                                    <th>Máquinas</th>
                                    <th>Filial</th>
                                    <th class="text-end" style="width: 120px;">Ação</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for net in discovered_networks %}
                                {# Nome escolhido: o salvo; sem ele, a sugestao pelo IP (a T.I. confirma). #}
                                {%- set chosen = net.branch_name ?: net.suggested -%}
                                <tr class="{{ net.branch_name ? '' : 'ar-net-pending' }}">
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="ti ti-router text-muted"></i>
                                            <strong class="font-monospace">{{ net.gateway_ip ?: '—' }}</strong>
                                            {% if not net.branch_name %}<span class="badge bg-orange-lt">sem filial</span>{% endif %}
                                        </div>
                                    </td>
                                    <td>
                                        <code class="font-monospace user-select-all">{{ net.gateway_mac }}</code>
                                    </td>
                                    <td>
                                        <span class="badge bg-blue-lt">{{ net.machine_count }} máquina(s)</span>
                                        {% if net.sample_machines %}
                                            <div class="text-muted small text-truncate mt-1" style="max-width: 280px;" title="Máquinas nesta rede: {{ net.sample_machines }}">
                                                {{ net.sample_machines }}
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <form method="post" action="{{ self_url }}" class="d-flex gap-2 align-items-center" id="net-form-{{ loop.index }}">
                                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                            <input type="hidden" name="action" value="save_network">
                                            <input type="hidden" name="gateway_ip" value="{{ net.gateway_ip }}">
                                            <input type="hidden" name="gateway_mac" value="{{ net.gateway_mac }}">
                                            <select name="branch_name" class="form-select form-select-sm" style="min-width: 180px;" data-ar-branch-select>
                                                <option value="">-- Escolher filial --</option>
                                                {% for kb in known_branches %}
                                                    <option value="{{ kb }}" {% if chosen == kb %}selected{% endif %}>{{ kb }}</option>
                                                {% endfor %}
                                                <option value="__custom__" {% if chosen and chosen not in known_branches %}selected{% endif %}>Outro nome...</option>
                                            </select>
                                            <input type="text" name="custom_branch_name" class="form-control form-control-sm" style="min-width: 130px; {% if chosen in known_branches or not chosen %}display: none;{% endif %}" placeholder="Nome da filial" value="{% if chosen not in known_branches %}{{ chosen }}{% endif %}" data-ar-branch-custom>
                                        </form>
                                        {% if not net.branch_name and net.suggested %}
                                            <div class="small text-warning mt-1"><i class="ti ti-bulb"></i> Sugerido pelo IP ({{ net.machine_count }} máquinas neste roteador). Confira e salve.</div>
                                        {% elseif not net.branch_name and net.machine_count < 2 %}
                                            <div class="small text-muted mt-1">Uma máquina só: pode ser o roteador da casa de alguém (home office).</div>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <button type="submit" form="net-form-{{ loop.index }}" class="btn btn-sm btn-primary" title="Salvar filial para este roteador">
                                                <i class="ti ti-check me-1"></i>Salvar
                                            </button>
                                            {% if net.is_saved and net.id > 0 %}
                                                <form method="post" action="{{ self_url }}" class="d-inline" onsubmit="return confirm('Remover associação deste roteador?');">
                                                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                                    <input type="hidden" name="action" value="delete_network">
                                                    <input type="hidden" name="id" value="{{ net.id }}">
                                                    <button type="submit" class="btn btn-sm btn-ghost-danger" title="Remover"><i class="ti ti-trash"></i></button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">
                                        Nenhum roteador reportado com MAC ainda. Assim que as máquinas enviarem o relatório com o Ativa Guardian, aparecerão aqui automaticamente.
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {# Regras de IP para faixas exclusivas #}
                    <details class="mt-2 border rounded p-2 bg-white">
                        <summary class="cursor-pointer text-muted small fw-bold">
                            <i class="ti ti-adjustments-alt me-1"></i>Regras gerais por faixa de IP (redes com IP exclusivo: Matriz, Uberlândia, Araçatuba, Ribeirão Preto, Cuiabá)
                        </summary>
                        <form method="post" action="{{ self_url }}" class="mt-3">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="action" value="branches">
                            <div class="row g-3 align-items-start">
                                <div class="col-md-5">
                                    <label class="form-label small" for="ar-rules-text">Uma rede por linha (prefixo = Filial)</label>
                                    <textarea class="form-control font-monospace form-control-sm" id="ar-rules-text" name="rules" rows="5" placeholder="192.168.80 = Matriz&#10;192.168.200 = Uberlandia">{{ branch_rules }}</textarea>
                                </div>
                                <div class="col-md-7 small text-muted">
                                    <p class="mb-1">Ordem de prioridade para identificar a filial:</p>
                                    <ol class="mb-2 ps-3">
                                        <li><strong>Roteador com filial</strong> definida na tabela acima (resolve as filiais em 192.168.0.1);</li>
                                        <li><strong>Switch</strong> da empresa onde o cabo está ligado;</li>
                                        <li><strong>Faixa de IP</strong> abaixo, mas só para roteador visto por 2 ou mais máquinas (192.168.1.1 e 192.168.0.1 também são IPs de roteador de casa);</li>
                                        <li><strong>Entidade ou localização</strong> do GLPI;</li>
                                        <li><strong>Última filial</strong> onde a máquina foi vista (home office).</li>
                                    </ol>
                                    <button type="submit" class="btn btn-sm btn-secondary"><i class="ti ti-device-floppy me-1"></i>Salvar regras de IP</button>
                                </div>
                            </div>
                        </form>
                    </details>
                </div>
            {% endif %}

            {% for b in branches %}
                <section class="ar-eq-branch" data-ar-section="{{ b.key }}">
                    <header class="ar-eq-branch-head">
                        <span class="ar-eq-branch-icon"><i class="ti {{ b.name ? 'ti-building' : 'ti-help-hexagon' }}"></i></span>
                        <h3>{{ b.name ?: 'Sem filial' }}</h3>
                        <span class="ar-eq-branch-meta"><span data-ar-shown>{{ b.machines|length }}</span> máquina(s) · {{ b.online }} ligada(s)</span>
                    </header>
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table ar-eq-table">
                            <thead>
                                <tr>
                                    <th>Pessoa</th>
                                    <th>Mesa</th>
                                    <th>Rede</th>
                                    <th>Monitores</th>
                                    <th class="text-end">Último relatório</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for m in b.machines %}
                                {%- set monitors_text = m.monitors|map(mon => mon.model ~ ' ' ~ mon.serial)|join(' ') -%}
                                <tr id="machine-{{ m.id }}"
                                    data-ar-row
                                    data-online="{{ m.online ? '1' : '0' }}"
                                    data-nodesk="{{ m.desk ? '0' : '1' }}"
                                    data-diag="{{ m.diagnostic ? '1' : '0' }}"
                                    data-search="{{ [m.title, m.person, m.user_auto, m.user_vpn, m.vpn_profile, m.user, m.group, m.computer, m.hostname, m.desk, m.ip, m.gateway_ip, m.gateway_mac, m.switch, m.port, monitors_text]|join(' ')|lower }}">
                                    <td class="ar-eq-who">
                                        <div class="ar-eq-person">
                                            <span class="ar-dot {{ m.online ? 'is-on' : 'is-off' }}" title="{{ m.online ? 'Ligada agora' : 'Sem contato agora' ~ (m.last_contact ? ' (último: ' ~ m.last_contact ~ ')' : '') }}"></span>
                                            <div class="ar-eq-person-text">
                                                <div class="ar-eq-name">
                                                    {% if m.person %}{{ m.person }}{% else %}<span class="text-muted">Sem usuário identificado</span>{% endif %}
                                                    {% if can_manage %}
                                                        <button type="button" class="ar-eq-edit-btn" data-ar-edit="{{ m.id }}" title="Corrigir o nome de quem usa esta máquina"><i class="ti ti-pencil"></i></button>
                                                    {% endif %}
                                                </div>
                                                <div class="ar-eq-machine">
                                                    <i class="ti ti-device-desktop"></i>
                                                    {% if m.computer_url %}<a href="{{ m.computer_url }}">{{ m.computer ?: m.hostname }}</a>{% else %}<span>{{ m.computer ?: m.hostname }}</span> <span class="ar-eq-tag is-muted" title="Série/nome não encontrados no inventário do GLPI">fora do GLPI</span>{% endif %}
                                                    {% if m.computer and m.hostname and m.computer != m.hostname %}<span class="text-muted">· {{ m.hostname }}</span>{% endif %}
                                                </div>
                                                {%- set details = [] -%}
                                                {%- if m.person_source == 'vpn' %}{% set details = details|merge(['pela VPN: ' ~ m.vpn_profile]) %}{% endif -%}
                                                {%- if m.person_source != 'auto' and m.user_auto %}{% set details = details|merge(['Windows: ' ~ m.user_auto]) %}{% endif -%}
                                                {%- if m.user and m.user != m.person and m.user != m.user_auto %}{% set details = details|merge(['GLPI: ' ~ m.user]) %}{% endif -%}
                                                {%- if m.group %}{% set details = details|merge([m.group]) %}{% endif -%}
                                                {% if details|length %}<div class="ar-eq-sub">{{ details|join(' · ') }}</div>{% endif %}
                                                {% if m.diagnostic %}
                                                    <div class="ar-eq-diag" title="{{ m.diagnostic }}"><i class="ti ti-alert-circle"></i><span>Coleta incompleta: {{ m.diagnostic }}</span></div>
                                                {% endif %}
                                            </div>
                                        </div>
                                        {% if can_manage %}
                                            {# Nome corrigido a mao; vazio = automatico (Windows / GLPI). #}
                                            <form method="post" action="{{ self_url }}" class="ar-eq-edit" data-ar-edit-form="{{ m.id }}" hidden>
                                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                                <input type="hidden" name="action" value="machine_user">
                                                <input type="hidden" name="id" value="{{ m.id }}">
                                                <input class="form-control form-control-sm" name="user_label" value="{{ m.user_label }}" maxlength="64"
                                                       placeholder="{{ m.person_auto ?: 'Nome do usuário' }}"
                                                       title="Deixe vazio para voltar ao nome automático{{ m.person_auto ? ' (' ~ m.person_auto ~ ')' : '' }}">
                                                <button class="btn btn-sm btn-primary" title="Salvar"><i class="ti ti-check"></i></button>
                                                <button type="button" class="btn btn-sm btn-ghost-secondary" data-ar-edit="{{ m.id }}" title="Cancelar"><i class="ti ti-x"></i></button>
                                            </form>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if m.desk %}<span class="ar-eq-desk">{{ m.desk }}</span>{% else %}<span class="ar-eq-tag is-muted">sem mesa</span>{% endif %}
                                        {% if m.since %}<div class="ar-eq-sub" title="Nesta posição desde">desde {{ m.since|slice(0, 10) }}</div>{% endif %}
                                    </td>
                                    <td>
                                        {% if m.port %}
                                            <span class="ar-port-tag" title="Switch · porta">{{ m.switch }} · {{ m.port }}</span>
                                        {% endif %}
                                        <div class="ar-eq-sub">
                                            {%- if m.link == 'wifi' %}<i class="ti ti-wifi"></i> Wi-Fi{% elseif m.link == 'wired' %}<i class="ti ti-plug"></i> Cabo{% elseif m.link == 'none' %}Sem rede{% endif -%}
                                            {%- if m.ip %} · <span class="font-monospace">{{ m.ip }}</span>{% endif -%}
                                            {%- if m.is_roaming %}
                                                <span class="badge bg-purple-lt ms-1" title="Em trânsito / Home office (Gateway: {{ m.gateway_ip ?: 'Desconhecido' }}{{ m.gateway_mac ? ' · MAC: ' ~ m.gateway_mac : '' }})"><i class="ti ti-home me-1"></i>Remoto</span>
                                            {%- elseif m.gateway_mac %}
                                                <span class="text-muted small ms-1" title="Roteador: {{ m.gateway_ip }} (MAC {{ m.gateway_mac }})"><i class="ti ti-router"></i></span>
                                            {%- endif -%}
                                        </div>
                                        {% if m.pending %}<div class="text-warning small"><i class="ti ti-arrows-exchange"></i> mudando para {{ m.pending }}?</div>{% endif %}
                                    </td>
                                    <td>
                                        {% for mon in m.monitors %}
                                            <div class="ar-eq-mon {{ mon.missing ? 'is-missing' : '' }}" title="{{ mon.model }}{{ mon.serial ? ' · série ' ~ mon.serial : '' }}{{ mon.missing ? ' · ausente desde ' ~ mon.missing_since : '' }}">
                                                <i class="ti {{ mon.missing ? 'ti-alert-triangle' : 'ti-device-desktop-analytics' }}"></i>
                                                <span>{{ mon.model }}</span>{% if mon.serial %}<span class="ar-eq-serial">{{ mon.serial }}</span>{% endif %}
                                                {% if mon.missing %}<span class="ar-eq-tag is-danger">ausente</span>{% endif %}
                                            </div>
                                        {% else %}<span class="text-muted small">—</span>{% endfor %}
                                    </td>
                                    <td class="text-end text-nowrap small" title="Último relatório: {{ m.last_report ?: 'nunca' }}">{{ fmt.when(m.last_report, today) }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
            {% else %}
                <p class="ar-empty-hint text-center py-4 mb-0">Nenhuma máquina enviou a posição ainda. É preciso o Ativa Guardian 1.6.0 ou mais novo nas máquinas.</p>
            {% endfor %}
            <p class="ar-empty-hint text-center py-4 mb-0" data-ar-nothing hidden>Nenhuma máquina com esse filtro.</p>
        </div>

        {# ------------------------------------------------------------ Sem posicao #}
        {% if missing|length %}
            <div class="ar-eq-pane" data-ar-pane="missing" hidden>
                <div class="ar-eq-toolbar">
                    <span class="text-muted small">Máquinas com o Ativa Guardian que ainda não informaram a posição.</span>
                    {% if can_manage %}
                        <form method="post" action="{{ self_url }}" class="ms-auto">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                            <input type="hidden" name="action" value="collect">
                            <button type="submit" class="btn btn-sm btn-outline-primary"
                                    title="Pede às máquinas ligadas que enviem a posição agora (inclusive as que estão esperando após um erro).">
                                <i class="ti ti-refresh me-1"></i>Pedir envio agora
                            </button>
                        </form>
                    {% endif %}
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-vcenter card-table">
                        <thead><tr><th>Computador</th><th>Guardian</th><th>Último contato</th><th>Motivo provável</th></tr></thead>
                        <tbody>
                        {% for g in missing %}
                            <tr>
                                <td>{{ g.label }}</td>
                                <td class="font-monospace small">{{ g.version ?: '—' }}</td>
                                <td class="small text-nowrap">{{ g.last_contact ?: '—' }}</td>
                                <td class="small">{{ g.reason }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}

        {# ------------------------------------------------------------ Monitores #}
        <div class="ar-eq-pane" data-ar-pane="monitores" hidden>
            <div class="table-responsive">
                <table class="table table-sm table-vcenter card-table">
                    <thead>
                        <tr><th>Modelo</th><th>Série</th><th>Fabricação</th><th>Conexão</th><th>Computador</th><th>Mesa</th><th>Desde</th><th>Situação</th><th>Por onde passou</th></tr>
                    </thead>
                    <tbody>
                    {% for mon in monitors %}
                        <tr>
                            <td>{% if mon.glpi_url %}<a href="{{ mon.glpi_url }}">{{ mon.model }}</a>{% else %}{{ mon.model }}{% endif %}</td>
                            <td class="font-monospace small">{{ mon.serial ?: 'não informada' }}</td>
                            <td class="small">{{ mon.year ?: '—' }}</td>
                            <td class="small">{{ mon.connection ?: '—' }}</td>
                            <td>{% if mon.machine_url %}<a href="{{ mon.machine_url }}">{{ mon.machine }}</a>{% else %}{{ mon.machine ?: '—' }}{% endif %}</td>
                            <td>{{ mon.desk ?: '—' }}</td>
                            <td class="small text-nowrap">{{ mon.since }}</td>
                            <td class="small">{% if mon.missing %}<span class="text-danger">Ausente desde {{ mon.missing_since }}</span>{% else %}Conectado{% endif %}</td>
                            <td class="small" style="min-width:260px">
                                {% for h in mon.history %}
                                    <div class="mb-1"><span class="text-muted">{{ h.date }}</span> · <strong>{{ h.label }}</strong><div class="text-muted">{{ h.detail }}</div></div>
                                {% else %}<span class="text-muted">sem mudanças registradas</span>{% endfor %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="9" class="text-center text-muted py-4">Nenhum monitor informado ainda.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# ------------------------------------------------------------ Switches #}
        <div class="ar-eq-pane" data-ar-pane="switches" hidden>
            <div class="table-responsive">
                <table class="table table-sm table-vcenter card-table">
                    <thead>
                        <tr><th>Apelido (aparece nas mesas)</th><th>Filial</th><th>IP de gerência</th><th>Nome / série</th><th>Modelo</th><th>Máquinas</th><th>Visto por último</th>{% if can_manage %}<th></th>{% endif %}</tr>
                    </thead>
                    <tbody>
                    {% for s in switches %}
                        <tr>
                            <td>
                                {% if can_manage %}
                                    <form method="post" action="{{ self_url }}" class="d-flex gap-1" style="max-width:240px">
                                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                        <input type="hidden" name="id" value="{{ s.id }}">
                                        <input class="form-control form-control-sm" name="label" value="{{ s.label }}" maxlength="64" placeholder="{{ s.short }}">
                                        <button class="btn btn-sm btn-outline-primary" title="Salvar apelido"><i class="ti ti-device-floppy"></i></button>
                                    </form>
                                {% else %}{{ s.label ?: s.short }}{% endif %}
                            </td>
                            <td>{{ s.branch ?: '—' }}</td>
                            <td class="font-monospace small">{{ s.mgmt_ip ?: '—' }}</td>
                            <td class="small">{{ s.system_name ?: '—' }}<div class="text-muted font-monospace">{{ s.chassis_id }}</div></td>
                            <td class="small">{{ s.description ?: '—' }}</td>
                            <td>{{ s.machines }}</td>
                            <td class="small text-nowrap">{{ s.last_seen }}</td>
                            {% if can_manage %}
                                <td class="text-end">
                                    <form method="post" action="{{ self_url }}"
                                          onsubmit="return confirm('Marcar {{ (s.label ?: s.short)|e('js') }} como \'não é switch\'? Ele some da lista e deixa de definir a posição das máquinas.');">
                                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                        <input type="hidden" name="action" value="ignore_switch">
                                        <input type="hidden" name="id" value="{{ s.id }}">
                                        <button class="btn btn-sm btn-ghost-danger text-nowrap" title="PC, telefone ou switchzinho de mesa identificado por engano">
                                            <i class="ti ti-ban me-1"></i>Não é switch
                                        </button>
                                    </form>
                                </td>
                            {% endif %}
                        </tr>
                    {% else %}
                        <tr><td colspan="8" class="text-center text-muted py-4">Nenhum switch identificado ainda.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% if ignored_switches|length %}
                    <div class="card-footer small text-muted">
                        <div class="mb-1"><i class="ti ti-ban me-1"></i>Marcados como "não é switch" ({{ ignored_switches|length }}) — ignorados nos relatórios:</div>
                        {% for s in ignored_switches %}
                            <form method="post" action="{{ self_url }}" class="d-inline-flex align-items-center gap-1 me-3">
                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                <input type="hidden" name="action" value="restore_switch">
                                <input type="hidden" name="id" value="{{ s.id }}">
                                <span>{{ s.system_name ?: s.short }} <span class="font-monospace">{{ s.chassis_id }}</span></span>
                                {% if can_manage %}<button class="btn btn-sm btn-link p-0" title="Voltar a considerar como switch">desfazer</button>{% endif %}
                            </form>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script src="{{ js_url }}"></script>
