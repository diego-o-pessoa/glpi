{% extends '@ativaworkspace/_layout.html.twig' %}

{% block content %}
    {% set filters = [
        {'key': 'all', 'label': 'Computadores', 'hint': counts.online ~ ' online agora','icon': 'ti ti-device-desktop', 'tone': 'blue'},
        {'key': 'offline', 'label': 'Offline', 'hint': 'Sem relato há mais de 3 min', 'icon': 'ti ti-plug-connected-x', 'tone': 'orange'},
        {'key': 'ram', 'label': 'RAM alta', 'hint': 'Uso de memória acima de 90%', 'icon': 'ti ti-alert-triangle-filled', 'tone': 'red'},
        {'key': 'outdated', 'label': 'Agente desatualizado', 'hint': latest_version ? 'Mais recente: ' ~ latest_version : 'Sem versão informada', 'icon': 'ti ti-refresh-alert', 'tone': 'green'}
    ] %}

    <div class="row row-cards mb-3">
        {% for f in filters %}
            <div class="col-sm-6 col-xl-3">
                <button type="button" class="card aw-kpi aw-kpi-{{ f.tone }} aw-filter h-100 w-100 text-start" data-aw-filter="{{ f.key }}">
                    <div class="card-body d-flex align-items-center gap-3">
                        <span class="aw-kpi-icon"><i class="{{ f.icon }}"></i></span>
                        <div>
                            <div class="aw-kpi-label">{{ f.label }}</div>
                            <div class="aw-kpi-value">{{ counts[f.key] }}</div>
                            <div class="aw-kpi-hint">{{ f.hint }}</div>
                        </div>
                    </div>
                </button>
            </div>
        {% endfor %}
    </div>

    <div class="card">
        <div class="card-header gap-3 flex-wrap">
            <h3 class="card-title mb-0"><i class="ti ti-device-desktop me-2"></i>Computadores com o Ativa Workspace</h3>
            <div class="ms-auto d-flex align-items-center gap-2 flex-wrap">
                <span class="text-muted small" data-aw-visible></span>
                <div class="input-icon aw-computer-search">
                    <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                    <input type="search" class="form-control form-control-sm" placeholder="Buscar computador ou usuário"
                           data-aw-search aria-label="Buscar computador ou usuário">
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-vcenter card-table aw-computers">
                <thead>
                    <tr>
                        <th>Computador</th>
                        <th>Usuário</th>
                        <th class="text-center">RAM</th>
                        <th class="text-center">CPU</th>
                        <th class="text-center">Programas</th>
                        <th>Agente</th>
                        <th>Último relato</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for m in machines %}
                        {% set outdated = m.agent_version and m.agent_version != latest_version %}
                        <tr data-aw-row
                            data-online="{{ m.online ? 1 : 0 }}"
                            data-ram="{{ m.ram_percent >= 90 ? 1 : 0 }}"
                            data-outdated="{{ outdated ? 1 : 0 }}"
                            data-search="{{ (m.name ~ ' ' ~ m.hostname ~ ' ' ~ m.username ~ ' ' ~ m.glpi_user)|lower }}">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="aw-status-dot {{ m.online ? 'is-online' : 'is-offline' }}"
                                          title="{{ m.online ? 'Online' : 'Offline' }}"></span>
                                    <div>
                                        <div class="fw-medium">{{ m.name }}</div>
                                        {% if m.hostname and m.hostname|lower != m.name|lower %}<small class="text-muted">{{ m.hostname }}</small>{% endif %}
                                    </div>
                                </div>
                            </td>
                            <td>
                                {% if m.username or m.glpi_user %}
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="ti ti-user text-muted"></i>
                                        <div>
                                            <div>{{ m.username ?: m.glpi_user }}</div>
                                            {% if m.username and m.glpi_user %}<small class="text-muted">{{ m.glpi_user }}</small>{% endif %}
                                        </div>
                                    </div>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <span class="badge {{ m.ram_percent >= 90 ? 'bg-danger-lt' : (m.ram_percent >= 75 ? 'bg-warning-lt' : 'bg-green-lt') }}">{{ m.ram_percent }}%</span>
                            </td>
                            <td class="text-center">
                                <span class="badge {{ m.cpu_percent >= 90 ? 'bg-danger-lt' : (m.cpu_percent >= 75 ? 'bg-warning-lt' : 'bg-secondary-lt') }}">{{ m.cpu_percent }}%</span>
                            </td>
                            <td class="text-center">{{ m.programs }}</td>
                            <td>
                                {% if m.agent_version %}
                                    <span class="badge {{ outdated ? 'bg-warning-lt' : 'bg-secondary-lt' }}"
                                          {% if outdated %}title="Desatualizado (mais recente: {{ latest_version }})"{% endif %}>{{ m.agent_version }}</span>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="text-nowrap {{ m.online ? '' : 'text-warning' }}">
                                <small>{{ m.reported_at ? m.reported_at|date('d/m/Y H:i') : '—' }}</small>
                            </td>
                            <td class="text-end">
                                <a href="{{ base_url }}?computer={{ m.computers_id }}" class="btn btn-sm btn-outline-primary">
                                    <i class="ti ti-eye me-1"></i>Ver
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8" class="text-center text-muted py-4">Nenhum computador reportou inventário ainda.</td></tr>
                    {% endfor %}
                    {% if machines|length > 0 %}
                        <tr data-aw-empty hidden><td colspan="8" class="text-center text-muted py-4">Nenhum computador encontrado com esse filtro.</td></tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
    (function () {
        var key = 'ativaworkspace.computers';
        var search = document.querySelector('[data-aw-search]');
        var rows = Array.prototype.slice.call(document.querySelectorAll('[data-aw-row]'));
        var cards = Array.prototype.slice.call(document.querySelectorAll('[data-aw-filter]'));
        var empty = document.querySelector('[data-aw-empty]');
        var visibleLabel = document.querySelector('[data-aw-visible]');
        var state = {filter: 'all', q: ''};
        // A pagina recarrega a cada minuto: mantem busca e filtro.
        try { state = Object.assign(state, JSON.parse(sessionStorage.getItem(key) || '{}')); } catch (e) {}

        function apply() {
            var q = state.q.trim().toLowerCase();
            var shown = 0;
            rows.forEach(function (row) {
                var ok = (state.filter === 'all'
                    || (state.filter === 'offline' && row.dataset.online === '0')
                    || (state.filter === 'ram' && row.dataset.ram === '1')
                    || (state.filter === 'outdated' && row.dataset.outdated === '1'))
                    && (q === '' || row.dataset.search.indexOf(q) !== -1);
                row.hidden = !ok;
                if (ok) { shown++; }
            });
            cards.forEach(function (card) {
                card.classList.toggle('is-active', card.dataset.awFilter === state.filter);
            });
            if (empty) { empty.hidden = shown > 0; }
            if (visibleLabel) {
                visibleLabel.textContent = shown === rows.length ? '' : shown + ' de ' + rows.length;
            }
            try { sessionStorage.setItem(key, JSON.stringify(state)); } catch (e) {}
        }

        cards.forEach(function (card) {
            card.addEventListener('click', function () {
                var f = card.dataset.awFilter;
                state.filter = state.filter === f ? 'all' : f;
                apply();
            });
        });
        if (search) {
            search.value = state.q;
            search.addEventListener('input', function () { state.q = search.value; apply(); });
        }
        apply();

        // Nao recarrega no meio de uma digitacao.
        window.setInterval(function () {
            if (document.activeElement !== search) { window.location.reload(); }
        }, 60000);
    })();
    </script>
{% endblock %}
