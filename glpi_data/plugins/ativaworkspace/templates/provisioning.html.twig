{% extends '@ativaworkspace/_layout.html.twig' %}

{% block content %}
<div data-aw-live="{{ live|json_encode }}">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-rocket me-2 text-primary"></i>Provisionamentos</h3>
            <div class="card-actions d-flex align-items-center">
                <span class="aw-live-dot me-3" data-aw-live-status title="Atualização em tempo real">Ao vivo</span>
                {% if can_provision %}
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#aw-new-provisioning">
                        <i class="ti ti-plus"></i> Novo provisionamento
                    </button>
                {% endif %}
            </div>
        </div>
        {{ include('@ativaworkspace/_jobs_table.html.twig') }}
    </div>

    {{ include('@ativaworkspace/_modals.html.twig') }}
</div>

<script src="{{ script_url }}"></script>
{% endblock %}
