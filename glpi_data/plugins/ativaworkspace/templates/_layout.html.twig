{# Layout comum. A navegacao entre secoes fica na barra lateral do GLPI
   (secao "Ativa Workspace"). A Visao Geral substitui o bloco header. #}
<div class="ativaworkspace">
    {% block header %}
        <div class="card aw-hero aw-hero-compact mb-3">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="aw-hero-icon"><i class="{{ section_icon }}"></i></span>
                <div>
                    <div class="aw-hero-kicker">Ativa Workspace</div>
                    <h2 class="aw-hero-title mb-0">{{ section_title }}</h2>
                </div>
            </div>
        </div>
    {% endblock %}

    {% block content %}{% endblock %}
</div>
