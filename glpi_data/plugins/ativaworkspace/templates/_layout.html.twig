{# Layout comum: abas entre as secoes + cabecalho + conteudo.
   A Visao Geral substitui o bloco header pelo cabecalho grande. #}
<div class="ativaworkspace">
    <ul class="nav nav-tabs aw-tabs mb-3" role="tablist">
        {% for entry in nav %}
            <li class="nav-item">
                <a class="nav-link {{ entry.active ? 'active' : '' }}" href="{{ entry.href }}"
                   {% if entry.active %}aria-current="page"{% endif %}>
                    <i class="{{ entry.icon }} me-1"></i>{{ entry.title }}
                </a>
            </li>
        {% endfor %}
    </ul>

    {% block header %}
        <div class="card aw-hero aw-hero-compact mb-3">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="aw-hero-icon"><i class="{{ section_icon }}"></i></span>
                <div>
                    <div class="aw-hero-kicker">Ativa Workspace</div>
                    <h2 class="aw-hero-title mb-0">{{ section_title }}</h2>
                </div>
            </div>
        </div>
    {% endblock %}

    {% block content %}{% endblock %}
</div>
