{% extends '@ativaworkspace/_layout.html.twig' %}

{% block content %}
    {% set sys = inv.system %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0"><i class="ti ti-device-desktop me-2"></i>{{ name }}</h3>
        <a href="{{ back_url }}" class="btn btn-outline-secondary btn-sm"><i class="ti ti-arrow-left"></i> Voltar</a>
    </div>

    <div class="row row-cards mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card"><div class="card-body">
                <div class="text-muted">Memória RAM</div>
                <div class="h2 mb-1">{{ sys.ram_percent|default(0) }}%</div>
                <div class="small text-muted">{{ sys.ram_used_mb|default(0) }} / {{ sys.ram_total_mb|default(0) }} MB</div>
            </div></div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card"><div class="card-body">
                <div class="text-muted">CPU</div>
                <div class="h2 mb-1">{{ sys.cpu_percent|default(0) }}%</div>
                <div class="small text-muted">{{ sys.os|default('—') }}</div>
            </div></div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card"><div class="card-body">
                <div class="text-muted">Tempo ligado</div>
                <div class="h2 mb-1">{{ sys.uptime_hours|default(0) }} h</div>
            </div></div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card"><div class="card-body">
                <div class="text-muted">Último relato</div>
                <div class="h4 mb-1">{{ inv.reported_at ? inv.reported_at|date('d/m/Y H:i') : '—' }}</div>
                <div class="small text-muted">Agente {{ inv.agent_version ?: '—' }}</div>
            </div></div>
        </div>
    </div>

    <div class="row row-cards">
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><h3 class="card-title"><i class="ti ti-server me-2"></i>Discos</h3></div>
                <div class="list-group list-group-flush">
                    {% for d in inv.disks %}
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between"><strong>{{ d.drive }}</strong><span>{{ d.free_gb }} GB livres de {{ d.total_gb }} GB</span></div>
                            <div class="progress mt-1" style="height:6px;">
                                <div class="progress-bar {{ d.percent >= 90 ? 'bg-danger' : 'bg-primary' }}" style="width: {{ d.percent }}%"></div>
                            </div>
                        </div>
                    {% else %}
                        <div class="list-group-item text-muted">Sem dados de disco.</div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header"><h3 class="card-title"><i class="ti ti-cpu me-2"></i>Processos (maior uso de memória)</h3></div>
                <div class="table-responsive" style="max-height: 320px; overflow-y:auto;">
                    <table class="table table-sm card-table">
                        <thead><tr><th>Processo</th><th class="text-end">RAM (MB)</th></tr></thead>
                        <tbody>
                            {% for p in inv.processes %}
                                <tr><td>{{ p.name }}</td><td class="text-end">{{ p.ram_mb }}</td></tr>
                            {% else %}
                                <tr><td colspan="2" class="text-muted">Sem dados de processos.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h3 class="card-title mb-0"><i class="ti ti-apps me-2"></i>Programas instalados ({{ inv.programs|length }})</h3>
                    {% if can_manage %}
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-danger" data-aw-uninstall-selected disabled>
                                <i class="ti ti-trash"></i> Desinstalar selecionados (<span data-aw-sel-count>0</span>)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-aw-uninstall-all>
                                <i class="ti ti-trash-x"></i> Desinstalar todos
                            </button>
                        </div>
                    {% endif %}
                </div>
                <div class="table-responsive" style="max-height: 460px; overflow-y:auto;">
                    <table class="table table-sm table-hover card-table"
                           data-aw-uninstall data-url="{{ data_url }}" data-action="{{ action_url }}"
                           data-computer="{{ computers_id }}" data-csrf="{{ csrf }}">
                        <thead><tr>
                            {% if can_manage %}<th style="width:1%"><input type="checkbox" class="form-check-input m-0" data-aw-prog-all aria-label="Selecionar todos" /></th>{% endif %}
                            <th>Nome</th><th>Versão</th><th>Fabricante</th>{% if can_manage %}<th class="text-end">Ação</th>{% endif %}
                        </tr></thead>
                        <tbody>
                            {% for prog in inv.programs %}
                                {% set pending = actions[prog.key] ?? null %}
                                <tr data-aw-row-key="{{ prog.key }}">
                                    {% if can_manage %}
                                        <td>
                                            {% if prog.can_uninstall %}
                                                <input type="checkbox" class="form-check-input m-0" data-aw-prog-check
                                                       data-target="{{ prog.name }}" data-scope="{{ prog.scope }}" data-key="{{ prog.key }}" />
                                            {% endif %}
                                        </td>
                                    {% endif %}
                                    <td>{{ prog.name }}</td>
                                    <td>{{ prog.version ?: '—' }}</td>
                                    <td>{{ prog.publisher ?: '—' }}</td>
                                    {% if can_manage %}
                                        <td class="text-end" data-aw-row-status>
                                            {% if pending and pending.status in ['queued', 'running'] %}
                                                <span class="badge bg-blue-lt">{{ pending.status == 'running' ? 'Desinstalando…' : 'Na fila' }}</span>
                                            {% elseif pending and pending.status == 'failed' %}
                                                <span class="badge bg-danger-lt" title="{{ pending.message }}">Falhou</span>
                                            {% elseif pending and pending.status == 'done' %}
                                                <span class="badge bg-green-lt">Desinstalado</span>
                                            {% elseif prog.can_uninstall %}
                                                <button type="button" class="btn btn-sm btn-outline-danger" data-aw-uninstall-one
                                                        data-target="{{ prog.name }}" data-scope="{{ prog.scope }}" data-key="{{ prog.key }}">
                                                    <i class="ti ti-trash"></i> Desinstalar
                                                </button>
                                            {% else %}
                                                <span class="text-muted small">—</span>
                                            {% endif %}
                                        </td>
                                    {% endif %}
                                </tr>
                            {% else %}
                                <tr><td colspan="{{ can_manage ? 5 : 3 }}" class="text-muted">Sem dados de programas.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    {% if can_manage %}
    <div class="modal fade" id="aw-uninstall-modal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title mb-0"><i class="ti ti-trash me-2"></i>Desinstalando programas</h5>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Aguarde, não feche esta janela.</span>
                        <span class="text-muted small" data-aw-prog-text>0 de 0</span>
                    </div>
                    <div class="progress mb-3" style="height: 12px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" data-aw-prog-bar style="width:0%"></div>
                    </div>
                    <div class="list-group list-group-flush small" data-aw-prog-list style="max-height: 280px; overflow-y: auto;"></div>
                </div>
            </div>
        </div>
    </div>
    <script>
    (function () {
        var root = document.querySelector('[data-aw-uninstall]');
        if (!root) { return; }
        var dataUrl = root.dataset.url, actionUrl = root.dataset.action;
        var computer = root.dataset.computer, csrf = root.dataset.csrf;
        var modalEl = document.getElementById('aw-uninstall-modal');
        var modal = (window.bootstrap && modalEl)
            ? window.bootstrap.Modal.getOrCreateInstance(modalEl, { backdrop: 'static', keyboard: false })
            : null;
        var modalShown = false;
        var bar = document.querySelector('[data-aw-prog-bar]');
        var progText = document.querySelector('[data-aw-prog-text]');
        var list = document.querySelector('[data-aw-prog-list]');
        var selCount = document.querySelector('[data-aw-sel-count]');
        var btnSelected = document.querySelector('[data-aw-uninstall-selected]');
        var pollTimer = null, wasActive = false;

        var STATUS = {
            queued:  ['bg-blue-lt', 'Na fila'],
            running: ['bg-blue-lt', 'Desinstalando…'],
            done:    ['bg-green-lt', 'Desinstalado'],
            failed:  ['bg-danger-lt', 'Falhou']
        };

        function checks() { return Array.prototype.slice.call(root.querySelectorAll('[data-aw-prog-check]')); }
        function selected() { return checks().filter(function (c) { return c.checked; }); }

        function updateSelCount() {
            var n = selected().length;
            if (selCount) { selCount.textContent = n; }
            if (btnSelected) { btnSelected.disabled = n === 0; }
        }

        function post(items) {
            if (!items.length) { return; }
            var body = new FormData();
            body.append('_glpi_csrf_token', csrf);
            body.append('computer', computer);
            body.append('action', 'uninstall');
            items.forEach(function (it) {
                body.append('targets[]', it.target);
                body.append('scopes[]', it.scope);
                body.append('keys[]', it.key);
            });
            fetch(actionUrl, { method: 'POST', credentials: 'same-origin', body: body,
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'X-Glpi-Csrf-Token': csrf } })
                .then(function (r) { return r.json().catch(function () { return {}; }); })
                .then(function () { checks().forEach(function (c) { c.checked = false; }); updateSelCount(); startPolling(); });
        }

        function itemsFrom(nodes) {
            return nodes.map(function (n) { return { target: n.dataset.target, scope: n.dataset.scope, key: n.dataset.key }; });
        }

        root.addEventListener('click', function (event) {
            var one = event.target.closest('[data-aw-uninstall-one]');
            if (one) {
                if (window.confirm('Desinstalar ' + one.dataset.target + ' deste computador?')) {
                    post(itemsFrom([one]));
                }
            }
        });
        root.addEventListener('change', function (event) {
            if (event.target.matches('[data-aw-prog-check]')) { updateSelCount(); }
        });

        var all = document.querySelector('[data-aw-prog-all]');
        if (all) {
            all.addEventListener('change', function () {
                checks().forEach(function (c) { c.checked = all.checked; });
                updateSelCount();
            });
        }
        if (btnSelected) {
            btnSelected.addEventListener('click', function () {
                var items = itemsFrom(selected());
                if (items.length && window.confirm('Desinstalar ' + items.length + ' programa(s)?')) { post(items); }
            });
        }
        var btnAll = document.querySelector('[data-aw-uninstall-all]');
        if (btnAll) {
            btnAll.addEventListener('click', function () {
                var items = itemsFrom(checks());
                if (items.length && window.confirm('Desinstalar TODOS os ' + items.length + ' programas removíveis?')) { post(items); }
            });
        }

        function showModal(show) {
            if (!modal || show === modalShown) { return; }
            modalShown = show;
            if (show) { modal.show(); } else { modal.hide(); }
        }

        function renderProgress(data) {
            var counts = data.counts || {};
            var total = counts.total || 0;
            var finished = (counts.done || 0) + (counts.failed || 0);
            if (total === 0) { return; }
            var pct = total ? Math.round(finished / total * 100) : 0;
            bar.style.width = pct + '%';
            bar.classList.toggle('progress-bar-animated', data.active);
            progText.textContent = finished + ' de ' + total;
            list.innerHTML = '';
            (data.items || []).forEach(function (it) {
                var meta = STATUS[it.status] || ['bg-secondary-lt', it.status];
                var row = document.createElement('div');
                row.className = 'list-group-item d-flex justify-content-between align-items-center px-0 py-1 border-0';
                var name = document.createElement('span'); name.textContent = it.target;
                var badge = document.createElement('span'); badge.className = 'badge ' + meta[0]; badge.textContent = meta[1];
                if (it.status === 'failed' && it.message) { badge.title = it.message; }
                row.appendChild(name); row.appendChild(badge);
                list.appendChild(row);
                // So pinta a linha durante uma desinstalacao em andamento nesta
                // pagina. O historico antigo nao vale: o programa pode ter sido
                // reinstalado (o servidor ja decide isso ao montar a lista).
                if (!data.active && !wasActive) { return; }
                var cell = root.querySelector('tr[data-aw-row-key="' + (window.CSS && CSS.escape ? CSS.escape(it.key) : it.key) + '"] [data-aw-row-status]');
                if (cell) { cell.innerHTML = '<span class="badge ' + meta[0] + '">' + meta[1] + '</span>'; }
            });
        }

        function poll() {
            fetch(dataUrl + '?computer=' + encodeURIComponent(computer), { credentials: 'same-origin' })
                .then(function (r) { return r.json().catch(function () { return {}; }); })
                .then(function (data) {
                    if (!data.ok) { return; }
                    renderProgress(data);
                    if (data.active) {
                        wasActive = true;
                        showModal(true);
                        pollTimer = window.setTimeout(poll, 3000);
                    } else if (wasActive) {
                        // Terminou: mostra o 100% um instante, fecha e recarrega.
                        window.setTimeout(function () {
                            showModal(false);
                            window.location.reload();
                        }, 1500);
                    }
                });
        }
        function startPolling() {
            if (pollTimer) { window.clearTimeout(pollTimer); }
            poll();
        }

        updateSelCount();
        startPolling();
    })();
    </script>
    {% else %}
    <script>window.setTimeout(function () { window.location.reload(); }, 60000);</script>
    {% endif %}
{% endblock %}
