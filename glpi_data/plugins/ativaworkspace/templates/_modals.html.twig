{% import 'components/form/fields_macros.html.twig' as fields %}

{# Modal: Novo provisionamento (so para quem pode provisionar). #}
{% if can_provision %}
<div class="modal fade" id="aw-new-provisioning" tabindex="-1" aria-labelledby="aw-new-provisioning-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form class="modal-content" data-aw-new-form>
            <div class="modal-header">
                <h5 class="modal-title" id="aw-new-provisioning-title">
                    <i class="ti ti-rocket me-2 text-primary"></i>Novo provisionamento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                {% if profiles|length == 0 %}
                    <div class="alert alert-warning mb-0">
                        <i class="ti ti-alert-triangle me-1"></i>
                        Nenhum perfil de provisionamento ativo. <a href="{{ profiles_url }}">Cadastre um perfil</a> primeiro.
                    </div>
                {% else %}
                    <div class="alert alert-danger d-none" data-aw-new-error role="alert"></div>
                    <div class="row">
                        {{ fields.dropdownField('Computer', 'computers_id', 0, 'Computador', {
                            'entity': session('glpiactiveentities'),
                            'required': true,
                            'full_width': true,
                            'rand': 'awnew'
                        }) }}
                        {{ fields.dropdownArrayField('plugin_ativaworkspace_provisioningprofiles_id', profiles|keys|first, profiles, 'Perfil', {
                            'required': true,
                            'full_width': true,
                            'rand': 'awnew'
                        }) }}
                        {{ fields.textField('employee_name', '', 'Funcionário', {
                            'full_width': true,
                            'helper': 'Quem vai usar a máquina. Opcional.'
                        }) }}
                    </div>
                    <div class="text-muted small mt-2">
                        <i class="ti ti-info-circle me-1"></i>
                        O provisionamento entra na fila com as etapas ativas do perfil.
                        A execução automática das etapas chega numa próxima versão do Workspace.
                    </div>
                {% endif %}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                {% if profiles|length > 0 %}
                    <button type="submit" class="btn btn-primary" data-aw-new-submit>
                        <i class="ti ti-player-play"></i> Colocar na fila
                    </button>
                {% endif %}
            </div>
        </form>
    </div>
</div>
{% endif %}

{# Modal: detalhes / log de um provisionamento (preenchido pelo workspace.js). #}
<div class="modal fade" id="aw-job-details" tabindex="-1" aria-labelledby="aw-job-details-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="aw-job-details-title">
                    <i class="ti ti-file-text me-2"></i><span data-aw-detail-title>Provisionamento</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body" data-aw-detail-body>
                <div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>Carregando…</div>
            </div>
            <div class="modal-footer">
                <a href="#" class="btn btn-outline-secondary d-none" data-aw-detail-computer target="_self">
                    <i class="ti ti-device-desktop"></i> Abrir computador
                </a>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>
