{% extends '@ativaworkspace/_layout.html.twig' %}

{% block content %}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title"><i class="ti ti-apps me-2"></i>Aplicativos</h3>
            {% if can_create %}
                <a href="{{ form_url }}" class="btn btn-primary btn-sm"><i class="ti ti-plus"></i> Novo aplicativo</a>
            {% endif %}
        </div>
        <div class="card-body p-0">
            {% if rows|length == 0 %}
                <div class="empty py-4">
                    <div class="empty-icon"><i class="ti ti-apps"></i></div>
                    <p class="empty-title">Nenhum aplicativo cadastrado</p>
                    <p class="empty-subtitle text-muted">Catálogo dos programas que os perfis poderão instalar. Nesta etapa é só cadastro: nada é instalado.</p>
                </div>
            {% else %}
                <form method="post" action="{{ form_url }}">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Provider</th>
                                    <th>Versão desejada</th>
                                    <th>Situação</th>
                                    <th class="text-end">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for row in rows %}
                                <tr>
                                    <td>
                                        <a href="{{ form_url }}?id={{ row.id }}"><strong>{{ row.name }}</strong></a>
                                        {% if row.comment %}<div class="small text-muted text-truncate aw-truncate">{{ row.comment }}</div>{% endif %}
                                    </td>
                                    <td><span class="badge bg-azure-lt">{{ row.provider_label }}</span></td>
                                    <td>{{ row.desired_version ?: 'Mais recente' }}</td>
                                    <td>
                                        {% if row.is_active %}
                                            <span class="badge bg-success">Ativo</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Inativo</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a href="{{ form_url }}?id={{ row.id }}" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="ti ti-pencil"></i></a>
                                        {% if can_update %}
                                            <button type="submit" name="toggle" value="{{ row.id }}" class="btn btn-sm btn-outline-secondary"
                                                    title="{{ row.is_active ? 'Desativar' : 'Ativar' }}">
                                                <i class="ti {{ row.is_active ? 'ti-toggle-right' : 'ti-toggle-left' }}"></i>
                                            </button>
                                        {% endif %}
                                        {% if can_purge %}
                                            <button type="submit" name="purge" value="{{ row.id }}" class="btn btn-sm btn-outline-danger" title="Excluir"
                                                    onclick="return confirm('Excluir o aplicativo &quot;{{ row.name|e('js') }}&quot;?');">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
