{% extends '@ativaworkspace/_layout.html.twig' %}

{% block content %}
    <div class="card aw-simulation mb-3">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="fw-bold"><i class="ti ti-flask me-1"></i>Modo de simulação do Job Engine (desenvolvimento)</div>
                <div class="small">
                    Liga, na tela de cada provisionamento, botões para marcar a etapa atual como SUCCESS, FAILED,
                    WAITING_HUMAN ou SKIPPED. Serve só para testar o fluxo: nada é executado nos computadores.
                    Exige também o direito "Provisionar → Gerenciar".
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                {% if simulation_enabled %}
                    <span class="badge bg-warning">Ligado</span>
                {% else %}
                    <span class="badge bg-secondary">Desligado</span>
                {% endif %}
                {% if can_configure %}
                    <form method="post" action="{{ action_url }}" class="m-0">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
                        <button type="submit" name="simulation" value="{{ simulation_enabled ? '0' : '1' }}"
                                class="btn btn-sm {{ simulation_enabled ? 'btn-outline-secondary' : 'btn-warning' }}">
                            {{ simulation_enabled ? 'Desligar' : 'Ligar' }}
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>

    {# Microsoft Entra ID + API do executor #}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title"><i class="ti ti-brand-windows me-2 text-primary"></i>Microsoft Entra ID e executor</h3>
        </div>
        <div class="card-body">
            <form method="post" action="{{ action_url }}" class="row g-3">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
                <div class="col-md-6">
                    <label class="form-label" for="aw-entra-domain">Domínio do tenant</label>
                    <input type="text" class="form-control" id="aw-entra-domain" name="entra_domain" value="{{ entra_domain }}"
                           placeholder="ativalocacao.com.br" {{ can_configure ? '' : 'disabled' }} />
                    <div class="form-hint">Domínio Microsoft da empresa. Usado para validar o ingresso.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="aw-entra-tenant">Tenant ID (opcional)</label>
                    <input type="text" class="form-control font-monospace" id="aw-entra-tenant" name="entra_tenant_id" value="{{ entra_tenant_id }}"
                           placeholder="00000000-0000-0000-0000-000000000000" {{ can_configure ? '' : 'disabled' }} />
                    <div class="form-hint">GUID do tenant. Se preenchido, o ingresso só é aceito neste tenant (mais seguro que o domínio).</div>
                </div>
                {% if can_configure %}
                    <div class="col-12">
                        <button type="submit" name="save_entra" value="1" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Salvar Entra</button>
                    </div>
                {% endif %}
            </form>

            <hr>

            {# Microsoft Graph: gera o TAP (senha temporaria) automaticamente. #}
            <form method="post" action="{{ action_url }}" class="row g-3 mb-2">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
                <div class="col-12">
                    <div class="fw-semibold">
                        <i class="ti ti-key text-primary me-1"></i>Senha temporária (TAP) via Microsoft Graph
                        {% if graph_configured %}
                            <span class="badge bg-success ms-1">Configurado</span>
                        {% elseif graph_secret_stored and not encryption_ready %}
                            <span class="badge bg-danger ms-1">Chave do GLPI indisponível</span>
                        {% else %}
                            <span class="badge bg-secondary ms-1">Não configurado</span>
                        {% endif %}
                    </div>
                    <div class="form-hint">
                        App registrado no Entra com a permissão de aplicativo
                        <code>UserAuthMethod-TAP.ReadWrite.All</code> e consentimento administrativo.
                        O segredo é protegido pela <code>glpicrypt.key</code> do próprio GLPI.
                    </div>
                    {% if not encryption_ready %}
                        <div class="alert alert-danger mt-2 mb-0 py-2">
                            O GLPI não consegue acessar sua chave criptográfica. Não substitua o Client Secret até corrigir a
                            <code>glpicrypt.key</code> no servidor.
                        </div>
                    {% endif %}
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="aw-graph-id">Client ID do app</label>
                    <input type="text" class="form-control font-monospace" id="aw-graph-id" name="graph_client_id" value="{{ graph_client_id }}"
                           placeholder="00000000-0000-0000-0000-000000000000" {{ can_configure ? '' : 'disabled' }} />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="aw-graph-secret">Client secret</label>
                    <input type="password" class="form-control" id="aw-graph-secret" name="graph_client_secret" autocomplete="off"
                           placeholder="{{ graph_secret_stored ? '•••••••• (deixe em branco para manter)' : 'cole o Value do secret' }}" {{ can_configure ? '' : 'disabled' }} />
                    {% if graph_secret_stored and can_configure %}
                        <label class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" name="clear_graph_secret" value="1"
                                   onchange="if (this.checked && !confirm('Remover o Client Secret? A geração de TAP ficará indisponível.')) { this.checked = false; }" />
                            <span class="form-check-label text-danger">Remover o segredo armazenado</span>
                        </label>
                    {% endif %}
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="aw-tap-life">Validade do TAP (min)</label>
                    <input type="number" class="form-control" id="aw-tap-life" name="tap_lifetime_minutes" min="10" max="480" value="{{ tap_lifetime }}" {{ can_configure ? '' : 'disabled' }} />
                </div>
                {% if can_configure %}
                    <div class="col-12 d-flex flex-wrap align-items-center gap-2">
                        <button type="submit" name="save_graph" value="1" class="btn btn-primary"><i class="ti ti-device-floppy"></i> Salvar Graph</button>
                        <button type="button" class="btn btn-outline-primary" data-aw-graph-test
                                data-url="{{ graph_test_url }}" data-csrf="{{ graph_test_csrf }}"
                                {{ graph_configured ? '' : 'disabled' }}>
                            <i class="ti ti-plug-connected"></i> Testar conexão
                        </button>
                        <span class="small" data-aw-graph-result aria-live="polite"></span>
                    </div>
                {% endif %}
            </form>

            <hr>

            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label" for="aw-api-token">Token da API do executor</label>
                    <input type="text" class="form-control font-monospace" id="aw-api-token" value="{{ api_token }}" readonly />
                    <div class="form-hint">
                        O serviço nas máquinas usa este token para reportar o Entra ao Workspace.
                        {% if not api_enabled %}<span class="text-warning">API desabilitada.</span>{% endif %}
                    </div>
                </div>
                {% if can_configure %}
                    <div class="col-md-4 d-flex flex-wrap gap-2">
                        <form method="post" action="{{ config_download_url }}" class="m-0">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ download_csrf }}" />
                            <button type="submit" class="btn btn-primary"><i class="ti ti-download"></i> Baixar configuração</button>
                        </form>
                        <button type="button" class="btn btn-outline-secondary" data-aw-copy="#aw-api-token"><i class="ti ti-copy"></i> Copiar</button>
                        <form method="post" action="{{ action_url }}" class="m-0"
                              onsubmit="return confirm('Regenerar o token invalida o atual. O serviço das máquinas precisará do token novo. Continuar?');">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
                            <button type="submit" name="regenerate_token" value="1" class="btn btn-outline-danger"><i class="ti ti-refresh"></i> Regenerar</button>
                        </form>
                    </div>
                    <div class="col-12">
                        <div class="form-hint">
                            "Baixar configuração" gera o <code>ativaworkspace-service-config.json</code> que vai no build do pacote unificado.
                            O serviço nas máquinas passa a reportar o Entra sozinho — sem digitar token na máquina.
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="row row-cards">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="ti ti-info-circle me-2"></i>Ambiente</h3>
                </div>
                <div class="card-body p-0">
                    <table class="table table-vcenter mb-0">
                        <tbody>
                            <tr><th class="w-50">Versão do Workspace</th><td><code>{{ versions.workspace }}</code></td></tr>
                            <tr><th>Versão do GLPI</th><td><code>{{ versions.glpi }}</code></td></tr>
                            <tr><th>Versão do PHP</th><td><code>{{ versions.php }}</code></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title"><i class="ti ti-database me-2"></i>Instaladores</h3>
                </div>
                <div class="card-body p-0">
                    <table class="table table-vcenter mb-0">
                        <tbody>
                            <tr>
                                <th class="w-50">Diretório</th>
                                <td class="text-break"><code>{{ storage.directory }}</code></td>
                            </tr>
                            <tr>
                                <th>Gravação</th>
                                <td>
                                    {% if storage.writable %}
                                        <span class="badge bg-success">Permitida</span>
                                    {% else %}
                                        <span class="badge bg-danger">Sem permissão</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr><th>Limite efetivo de upload</th><td><strong>{{ storage.max_label }}</strong></td></tr>
                            <tr><th>PHP upload_max_filesize</th><td><code>{{ storage.upload_max }}</code></td></tr>
                            <tr><th>PHP post_max_size</th><td><code>{{ storage.post_max }}</code></td></tr>
                        </tbody>
                    </table>
                </div>
                {% if storage.low_limit %}
                    <div class="card-footer text-warning small">
                        <i class="ti ti-alert-triangle me-1"></i>
                        Limite baixo para instaladores (ex.: Chrome ~130 MB). Aumente <code>upload_max_filesize</code> e
                        <code>post_max_size</code> no PHP do servidor.
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="ti ti-plug-connected me-2"></i>Integrações detectadas</h3>
                </div>
                <div class="card-body p-0">
                    <table class="table table-vcenter mb-0">
                        <thead>
                            <tr><th>Plugin</th><th>Situação</th><th>Versão</th></tr>
                        </thead>
                        <tbody>
                        {% for plugin in plugins %}
                            <tr>
                                <td>{{ plugin.name }} <div class="small text-muted"><code>{{ plugin.directory }}</code></div></td>
                                <td><span class="badge {{ plugin.badge }}">{{ plugin.label }}</span></td>
                                <td>{{ plugin.version ?: '—' }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-muted small">
                    Só detecção. Nenhuma integração com esses plugins é feita nesta etapa.
                </div>
            </div>
        </div>
    </div>

    <script>
    (function () {
        document.querySelectorAll('[data-aw-copy]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var target = document.querySelector(btn.getAttribute('data-aw-copy'));
                if (target && navigator.clipboard) {
                    navigator.clipboard.writeText(target.value || '').then(function () {
                        btn.classList.add('btn-success');
                        setTimeout(function () { btn.classList.remove('btn-success'); }, 1200);
                    });
                }
            });
        });

        var testButton = document.querySelector('[data-aw-graph-test]');
        var testResult = document.querySelector('[data-aw-graph-result]');
        if (testButton && testResult) {
            testButton.addEventListener('click', function () {
                testButton.disabled = true;
                testResult.className = 'small text-muted';
                testResult.textContent = 'Validando credencial e permissão…';
                fetch(testButton.dataset.url, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-Glpi-Csrf-Token': testButton.dataset.csrf
                    }
                }).then(function (response) {
                    return response.json().catch(function () { return {}; });
                }).then(function (data) {
                    testResult.className = 'small ' + (data.ok ? 'text-success' : 'text-danger');
                    testResult.textContent = data.message || 'O teste não retornou uma resposta válida.';
                }).catch(function () {
                    testResult.className = 'small text-danger';
                    testResult.textContent = 'Falha de rede durante o teste.';
                }).finally(function () {
                    testButton.disabled = false;
                });
            });
        }
    })();
    </script>
{% endblock %}
