<div class="container-xl py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h1 class="h2 mb-1"><i class="ti ti-printer me-2 text-primary"></i>Configurações do Ativa Print</h1>
                    <p class="text-muted mb-0">Parâmetros de monitoramento SNMP, limites de suprimentos e comunicação.</p>
                </div>
                <a href="{{ urls.dashboard }}" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left me-1"></i> Voltar ao Painel
                </a>
            </div>

            {% if errors %}
                <div class="alert alert-danger mb-4">
                    <ul class="mb-0 ps-3">
                        {% for error in errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <div class="card shadow-sm border-0">
                <form method="post" action="">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

                    <div class="card-body p-4">
                        <h4 class="card-title text-primary mb-3"><i class="ti ti-network me-2"></i>Comunicação SNMP</h4>
                        
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Community SNMP padrão</label>
                                <input type="text" name="snmp_community" class="form-control" value="{{ config.snmp_community }}" required>
                                <div class="form-text">Geralmente "public" em redes internas.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Versão SNMP</label>
                                <select name="snmp_version" class="form-select">
                                    <option value="2c" {% if config.snmp_version == '2c' %}selected{% endif %}>SNMP v2c (Recomendado)</option>
                                    <option value="1" {% if config.snmp_version == '1' %}selected{% endif %}>SNMP v1</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tempo limite por consulta (ms)</label>
                                <input type="number" name="snmp_timeout" class="form-control" min="200" max="5000" step="100" value="{{ config.snmp_timeout }}" required>
                                <div class="form-text">Tempo de espera por resposta UDP (padrão: 1000 ms).</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tempo sem comunicação para alerta (minutos)</label>
                                <input type="number" name="offline_after" class="form-control" min="5" max="1440" value="{{ config.offline_after }}" required>
                                <div class="form-text">Considera impressora sem comunicação após este tempo.</div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <h4 class="card-title text-primary mb-3"><i class="ti ti-droplet-half-2 me-2"></i>Limites de Suprimentos (Toner / Cilindro)</h4>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Faixa de Atenção (%)</label>
                                <div class="input-group">
                                    <input type="number" name="toner_warning" class="form-control" min="2" max="50" value="{{ config.toner_warning }}" required>
                                    <span class="input-group-text">%</span>
                                </div>
                                <div class="form-text">Níveis abaixo deste valor entram no card "Toners em nível crítico".</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Estado Crítico (%)</label>
                                <div class="input-group">
                                    <input type="number" name="toner_critical" class="form-control" min="1" max="49" value="{{ config.toner_critical }}" required>
                                    <span class="input-group-text">%</span>
                                </div>
                                <div class="form-text">Nível urgente onde a TI precisa agir imediatamente.</div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-light p-3 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i> Salvar Configurações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

