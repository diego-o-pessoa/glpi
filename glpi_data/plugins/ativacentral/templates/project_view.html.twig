{# Tela do projeto no estilo do Ativa Central. #}
{% macro task_rows(nodes, depth) %}
    {% import _self as m %}
    {% for t in nodes %}
        {% set phase = t.children is not empty %}
        <div class="ac-ptask-node" data-node>
            <a href="{{ t.url }}" class="ac-ptask-row {{ phase ? 'is-phase' : '' }} kind-{{ t.kind }}" style="--depth: {{ depth }}">
                <div class="ac-ptask-name">
                    {% if phase %}
                        <button type="button" class="ac-ptask-toggle" data-toggle title="Recolher/expandir"><i class="ti ti-chevron-down"></i></button>
                        <i class="ti {{ t.leaf_total > 0 and t.leaf_done == t.leaf_total ? 'ti-circle-check-filled is-done' : 'ti-folder' }} ac-ptask-icon"></i>
                    {% else %}
                        <i class="ti {{ {'done': 'ti-circle-check-filled', 'running': 'ti-circle-half-2', 'cancelled': 'ti-circle-x'}[t.kind] ?? 'ti-circle' }} ac-ptask-icon"></i>
                    {% endif %}
                    <div class="ac-ptask-title">
                        <span class="ac-ptask-label" title="{{ t.name }}">{{ t.name }}</span>
                        <span class="ac-ptask-sub">
                            {% if t.type %}<span class="ac-ptask-type">{{ t.type }}</span>{% endif %}
                            {% if phase %}<span>{{ t.leaf_done }} de {{ t.leaf_total }} concluídas</span>{% endif %}
                        </span>
                    </div>
                </div>
                <div class="ac-ptask-col ac-ptask-status">
                    {% if phase %}
                        <span class="ac-ptask-state is-phase"><i class="ti ti-star-filled"></i> Principal</span>
                    {% else %}
                        <span class="ac-ptask-state kind-{{ t.kind }}">{{ t.state }}</span>
                    {% endif %}
                </div>
                <div class="ac-ptask-col ac-ptask-progress">
                    <div class="ac-ptask-bar"><span class="{{ t.percent >= 100 ? 'is-done' : '' }}" style="width: {{ t.percent }}%"></span></div>
                    <b>{{ t.percent }}%</b>
                </div>
                <div class="ac-ptask-col ac-ptask-dates">
                    <span>{{ t.start ?: '—' }} → {{ t.end ?: '—' }}</span>
                    {% if t.due == 'late' %}<small class="is-late">Atrasada</small>{% elseif t.due == 'soon' %}<small class="is-soon">Vence em breve</small>{% endif %}
                </div>
                <div class="ac-ptask-col ac-ptask-duration" title="Tempo que a tarefa levou até ser concluída">
                    <span>{{ t.duration }}</span>
                </div>
                <div class="ac-ptask-col ac-ptask-team">
                    {% for mbr in t.members|slice(0, 3) %}
                        <span class="ac-ptask-av" title="{{ mbr.name }}">{{ mbr.initials }}</span>
                    {% else %}
                        <span class="ac-ptask-none">—</span>
                    {% endfor %}
                    {% if t.members|length > 3 %}
                        <span class="ac-ptask-av is-more" title="{{ t.members|slice(3)|map(x => x.name)|join(', ') }}">+{{ t.members|length - 3 }}</span>
                    {% endif %}
                </div>
            </a>
            {% if phase %}
                <div class="ac-ptask-children">{{ m.task_rows(t.children, depth + 1) }}</div>
            {% endif %}
        </div>
    {% endfor %}
{% endmacro %}
{% import _self as macros %}
<link rel="stylesheet" type="text/css" href="{{ css_url }}">
<div class="ac-app ac-pnew ac-pview">
    <a class="ac-pview-back" href="{{ back }}"><i class="ti ti-arrow-left"></i> Voltar para Projetos</a>

    <div class="ac-panel ac-pview-hero">
        <div class="ac-pview-hero-main">
            <div class="ac-pview-badges">
                <span class="ac-pview-tag {{ priority_tone }}"><i class="ti ti-flag-filled"></i> {{ priority_label }}</span>
                <span class="ac-pview-tag is-state">{{ state_name }}</span>
            </div>
            <h1 class="ac-title">{{ name }}</h1>
            <div class="ac-pview-meta">
                <span><i class="ti ti-calendar"></i> {{ dates }}</span>
                {% if created %}<span><i class="ti ti-clock"></i> Criado em {{ created }}</span>{% endif %}
            </div>
        </div>
        <div class="ac-pview-progress">
            <div class="ac-pview-pct">{{ percent }}%</div>
            <div class="ac-pview-bar"><span style="width: {{ percent }}%"></span></div>
            <div class="ac-pview-pct-sub">concluído · calculado pelas tarefas</div>
        </div>
    </div>

    <div class="ac-pview-layout">
        <nav class="ac-panel ac-pview-nav">
            {% for t in tabs %}
                <a href="{{ t.url }}" class="ac-pview-nav-item {{ t.active ? 'is-active' : '' }}">
                    <i class="ti {{ t.icon }}"></i>
                    <span>{{ t.label }}</span>
                    {% if t.count > 0 %}<b>{{ t.count }}</b>{% endif %}
                </a>
            {% endfor %}
        </nav>

        <div class="ac-pview-content">
            {% if tab == 'tasks' %}
                <div class="ac-panel ac-ptasks">
                    <div class="ac-ptasks-head">
                        <div>
                            <h2 class="ac-pnew-title"><i class="ti ti-list-check"></i> Tarefas do projeto</h2>
                            <div class="ac-pnew-hint">{{ tasks_done }} de {{ tasks_total }} tarefas concluídas · clique numa tarefa para abrir</div>
                        </div>
                        <div class="ac-actions">
                            {% if tasks is not empty %}
                                <button type="button" class="ac-btn is-small" id="ac-ptask-collapse"><i class="ti ti-fold"></i> Recolher</button>
                            {% endif %}
                            {% if add_task_url %}
                                <a href="{{ add_task_url }}" class="ac-btn is-primary"><i class="ti ti-plus"></i> Adicionar tarefa</a>
                            {% endif %}
                        </div>
                    </div>
                    {% if tasks is empty %}
                        <div class="ac-ptasks-empty">
                            <i class="ti ti-list-details"></i>
                            <b>Nenhuma tarefa ainda</b>
                            <span>Crie as tarefas do projeto. Se quiser, marque uma como Principal (ex.: Planejamento) e coloque as outras dentro dela.</span>
                        </div>
                    {% else %}
                        <div class="ac-ptask-headrow">
                            <span>Tarefa</span><span>Status</span><span>Andamento</span><span>Prazo planejado</span><span>Duração</span><span>Equipe</span>
                        </div>
                        <div class="ac-ptask-list">{{ macros.task_rows(tasks, 0) }}</div>
                    {% endif %}
                </div>
                <script>
                    (function () {
                        document.querySelectorAll('.ac-ptask-toggle').forEach(function (btn) {
                            btn.addEventListener('click', function (e) {
                                e.preventDefault();
                                e.stopPropagation();
                                btn.closest('[data-node]').classList.toggle('is-collapsed');
                            });
                        });
                        var all = document.getElementById('ac-ptask-collapse');
                        if (all) {
                            all.addEventListener('click', function () {
                                var nodes = document.querySelectorAll('.ac-ptask-list > [data-node]');
                                var collapse = !Array.prototype.every.call(nodes, function (n) { return n.classList.contains('is-collapsed'); });
                                nodes.forEach(function (n) { if (n.querySelector('.ac-ptask-children')) { n.classList.toggle('is-collapsed', collapse); } });
                                all.lastChild.textContent = collapse ? ' Expandir' : ' Recolher';
                            });
                        }
                    })();
                </script>
            {% elseif tab_url is defined %}
                <div class="ac-panel ac-pview-glpi" id="ac-pview-tab" data-url="{{ tab_url }}">
                    <div class="ac-pview-loading"><span class="spinner-border spinner-border-sm"></span> Carregando…</div>
                </div>
                <script>
                    (function () {
                        var box = document.getElementById('ac-pview-tab');
                        // jQuery executa os scripts que vem no conteudo da aba (como na tela do GLPI).
                        $(box).load(box.getAttribute('data-url'), function (response, status) {
                            if (status === 'error') {
                                box.innerHTML = '<div class="ac-pnew-error"><i class="ti ti-alert-circle"></i> Não foi possível carregar esta aba. Atualize a página.</div>';
                            }
                        });
                    })();
                </script>
            {% else %}
                {% if error %}
                    <div class="ac-pnew-error"><i class="ti ti-alert-circle"></i> {{ error }}</div>
                {% endif %}
                <form method="post" action="{{ action }}" class="ac-pnew-form" autocomplete="off">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    {# Enter salva (o Excluir vem antes do Salvar no HTML). #}
                    <button type="submit" name="save" value="1" tabindex="-1" aria-hidden="true" style="position: absolute; left: -9999px; width: 1px; height: 1px;"></button>
                    {% set ro = not can_update %}

                    <section class="ac-panel ac-pnew-card">
                        <h2 class="ac-pnew-title"><i class="ti ti-clipboard-text"></i> Sobre o projeto</h2>
                        <label class="ac-pnew-field">
                            <span class="ac-pnew-label">Nome do projeto <b>*</b></span>
                            <input type="text" name="name" value="{{ f_name }}" class="ac-pnew-input" required maxlength="255" {{ ro ? 'readonly' : '' }}>
                        </label>
                        <div class="ac-pnew-field">
                            <span class="ac-pnew-label">Prioridade</span>
                            <div class="ac-pnew-prio">
                                {% for value, label in priorities %}
                                    <label class="ac-pnew-prio-opt is-p{{ value }}">
                                        <input type="radio" name="priority" value="{{ value }}" {{ value == f_priority ? 'checked' : '' }} {{ ro ? 'disabled' : '' }}>
                                        <span><i class="ti ti-flag-filled"></i> {{ label }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="ac-pnew-dates">
                            <div class="ac-pnew-field">
                                <span class="ac-pnew-label">Estado</span>
                                <div class="ac-pnew-glpi">{{ state_html|raw }}</div>
                            </div>
                            <div class="ac-pnew-field">
                                <span class="ac-pnew-label">Tipo</span>
                                <div class="ac-pnew-glpi">{{ type_html|raw }}</div>
                            </div>
                        </div>
                        <div class="ac-pnew-field">
                            <span class="ac-pnew-label">Descrição</span>
                            <div class="ac-pnew-glpi ac-pnew-editor">{{ content_html|raw }}</div>
                        </div>
                    </section>

                    <div class="ac-pnew-side">
                        <section class="ac-panel ac-pnew-card">
                            <h2 class="ac-pnew-title"><i class="ti ti-calendar"></i> Prazos</h2>
                            <span class="ac-pnew-label">Planejado</span>
                            <div class="ac-pnew-dates">
                                <label class="ac-pnew-field">
                                    <span class="ac-pnew-label">Início</span>
                                    <input type="date" name="plan_start_date" value="{{ f_start }}" class="ac-pnew-input" {{ ro ? 'readonly' : '' }}>
                                </label>
                                <label class="ac-pnew-field">
                                    <span class="ac-pnew-label">Fim</span>
                                    <input type="date" name="plan_end_date" value="{{ f_end }}" class="ac-pnew-input" {{ ro ? 'readonly' : '' }}>
                                </label>
                            </div>
                            <span class="ac-pnew-label">Real</span>
                            {% if is_manager and can_update %}
                                <div class="ac-pnew-dates is-stacked">
                                    <label class="ac-pnew-field">
                                        <span class="ac-pnew-hint">Início</span>
                                        <input type="datetime-local" name="real_start_date" value="{{ f_real_start }}" class="ac-pnew-input">
                                    </label>
                                    <label class="ac-pnew-field">
                                        <span class="ac-pnew-hint">Fim</span>
                                        <input type="datetime-local" name="real_end_date" value="{{ f_real_end }}" class="ac-pnew-input">
                                    </label>
                                </div>
                                <div class="ac-pnew-hint">Preenchidas sozinhas: início quando a primeira tarefa começa e fim quando todas terminam. Como gerente, você pode ajustar.</div>
                            {% else %}
                                <div class="ac-preal">
                                    <div><span>Início</span><b>{{ real_start_text ?: '—' }}</b></div>
                                    <div><span>Fim</span><b>{{ real_end_text ?: '—' }}</b></div>
                                </div>
                                <div class="ac-pnew-hint">{{ real_end_text ? 'Projeto concluído.' : 'O fim aparece quando todas as tarefas forem finalizadas.' }} Só o gerente do projeto pode alterar.</div>
                            {% endif %}
                        </section>

                        <section class="ac-panel ac-pnew-card">
                            <h2 class="ac-pnew-title"><i class="ti ti-user-star"></i> Gerente</h2>
                            <div class="ac-pnew-field">
                                <span class="ac-pnew-label">Usuário</span>
                                <div class="ac-pnew-glpi">{{ user_html|raw }}</div>
                            </div>
                            <div class="ac-pnew-field">
                                <span class="ac-pnew-label">Grupo</span>
                                <div class="ac-pnew-glpi">{{ group_html|raw }}</div>
                            </div>
                        </section>

                        {% if can_update %}
                            <div class="ac-pnew-submit">
                                {% if can_delete %}
                                    <button type="submit" name="delete" value="1" class="ac-btn ac-btn-danger" formnovalidate
                                            onclick="return confirm('Mover este projeto para a lixeira?');">
                                        <i class="ti ti-trash"></i> Excluir
                                    </button>
                                {% endif %}
                                <button type="submit" name="save" value="1" class="ac-btn is-primary"><i class="ti ti-check"></i> Salvar alterações</button>
                            </div>
                        {% endif %}
                    </div>
                </form>
            {% endif %}
        </div>
    </div>
</div>
