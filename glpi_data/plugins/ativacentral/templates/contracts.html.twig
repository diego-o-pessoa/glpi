{# Lista de contratos no estilo do Ativa Central. #}
<link rel="stylesheet" type="text/css" href="{{ css_url }}">
<div class="ac-app ac-sup">
    <div class="ac-head">
        <div>
            <div class="ac-eyebrow">Ativa Central · Parceiros</div>
            <h1 class="ac-title">Contratos</h1>
            <div class="ac-subtitle">Vigência, renovação, documentos e avisos dos contratos com fornecedores.</div>
        </div>
        <div class="ac-actions">
            {% if new_url %}
                <a class="ac-btn is-primary" href="{{ new_url }}"><i class="ti ti-plus"></i> Adicionar contrato</a>
            {% endif %}
        </div>
    </div>

    <div class="ac-sup-kpis">
        <div class="ac-panel ac-sup-kpi"><span class="ac-sup-kpi-icon is-blue"><i class="ti ti-file-certificate"></i></span><div><b>{{ kpis.total }}</b><small>contratos</small></div></div>
        <div class="ac-panel ac-sup-kpi"><span class="ac-sup-kpi-icon is-green"><i class="ti ti-circle-check"></i></span><div><b>{{ kpis.active }}</b><small>vigentes</small></div></div>
        <div class="ac-panel ac-sup-kpi"><span class="ac-sup-kpi-icon is-orange"><i class="ti ti-alarm"></i></span><div><b>{{ kpis.expiring }}</b><small>vencem em 30 dias</small></div></div>
        <div class="ac-panel ac-sup-kpi"><span class="ac-sup-kpi-icon is-red"><i class="ti ti-alert-triangle"></i></span><div><b>{{ kpis.expired }}</b><small>vencidos</small></div></div>
    </div>

    <div class="ac-panel ac-sup-list">
        <div class="ac-sup-toolbar">
            <div class="ac-sup-filters">
                <button type="button" class="ac-sup-filter is-active" data-filter="all">Todos</button>
                <button type="button" class="ac-sup-filter" data-filter="tone:green">Vigentes</button>
                <button type="button" class="ac-sup-filter" data-filter="tone:orange">Vencendo</button>
                <button type="button" class="ac-sup-filter" data-filter="tone:red">Vencidos</button>
                <button type="button" class="ac-sup-filter" data-filter="tone:muted">Sem prazo</button>
            </div>
            <label class="ac-sup-search">
                <i class="ti ti-search"></i>
                <input type="search" id="ac-list-search" placeholder="Buscar por nome, número, fornecedor…">
            </label>
        </div>

        {% if contracts is empty %}
            <div class="ac-ptasks-empty"><i class="ti ti-file-certificate"></i><b>Nenhum contrato ainda</b><span>Use "Adicionar contrato" para cadastrar o primeiro.</span></div>
        {% else %}
            <div class="ac-cr-list">
                {% for c in contracts %}
                    <a class="ac-cr-row ac-list-row" href="{{ c.url }}" data-tone="{{ c.situation.tone }}"
                       data-search="{{ (c.name ~ ' ' ~ c.num ~ ' ' ~ c.type_label ~ ' ' ~ c.suppliers|map(s => s.name)|join(' '))|lower }}">
                        <span class="ac-sup-kpi-icon is-violet"><i class="ti ti-file-certificate"></i></span>
                        <div class="ac-cr-main">
                            <b>{{ c.name }}</b>
                            <small>
                                {% if c.num %}<span>Nº {{ c.num }}</span>{% endif %}
                                {% if c.type_label %}<span class="ac-ptask-type">{{ c.type_label }}</span>{% endif %}
                                {% for s in c.suppliers %}<span><i class="ti ti-building-store"></i> {{ s.name }}</span>{% else %}<span>Sem fornecedor</span>{% endfor %}
                            </small>
                        </div>
                        <div class="ac-cr-period">
                            <span><i class="ti ti-calendar"></i> {{ c.begin_text ?: '—' }} → {{ c.end_text ?: '—' }}</span>
                            <small>{{ c.duration > 0 ? c.duration ~ (c.duration == 1 ? ' mês' : ' meses') : 'Sem duração' }}{{ c.renewal_label ? ' · Renovação ' ~ c.renewal_label|lower : '' }}</small>
                        </div>
                        <span class="ac-cr-sit is-{{ c.situation.tone }}">{{ c.situation.label }}</span>
                        <i class="ti ti-chevron-right ac-sup-go"></i>
                    </a>
                {% endfor %}
            </div>
            <div class="ac-ptasks-empty" id="ac-list-none" hidden><i class="ti ti-search"></i><b>Nada encontrado</b><span>Tente outro termo ou filtro.</span></div>
        {% endif %}
    </div>
</div>
<script>
    (function () {
        var rows = Array.prototype.slice.call(document.querySelectorAll('.ac-list-row'));
        var search = document.getElementById('ac-list-search');
        var none = document.getElementById('ac-list-none');
        var filter = 'all';
        function apply() {
            var q = (search && search.value || '').trim().toLowerCase();
            var shown = 0;
            rows.forEach(function (r) {
                var ok = (!q || r.getAttribute('data-search').indexOf(q) !== -1)
                    && (filter === 'all'
                        || (filter.indexOf('tone:') === 0 && r.getAttribute('data-tone') === filter.slice(5)));
                r.hidden = !ok;
                shown += ok ? 1 : 0;
            });
            if (none) { none.hidden = shown > 0; }
        }
        document.querySelectorAll('.ac-sup-filter').forEach(function (b) {
            b.addEventListener('click', function () {
                document.querySelectorAll('.ac-sup-filter').forEach(function (x) { x.classList.toggle('is-active', x === b); });
                filter = b.getAttribute('data-filter');
                apply();
            });
        });
        if (search) { search.addEventListener('input', apply); }
    })();
</script>
