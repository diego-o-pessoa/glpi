{# Tela "Chamados" do Super-Admin: cards por situacao e fila com filtro. #}
<link rel="stylesheet" type="text/css" href="{{ css_url }}">
<div class="ac-tk-layout" id="ac-tk-layout">
    <aside class="ac-tk-side" id="ac-tk-side">
        <button type="button" class="ac-tk-side-toggle" id="ac-tk-side-toggle" title="Expandir ou recolher filtros">
            <i class="ti ti-layout-sidebar-left-collapse"></i><span>Filtros</span>
        </button>
        <div class="ac-tk-side-sec">
            <small>Visão</small>
            <button type="button" data-filter="open" title="Todos abertos"><i class="ti ti-inbox"></i><span>Todos abertos</span><em>{{ open_count }}</em></button>
            <button type="button" data-filter="mine" title="Meus chamados"><i class="ti ti-user-check"></i><span>Meus chamados</span><em>{{ kpis.mine }}</em></button>
            <button type="button" data-filter="sit:finished" title="Finalizados"><i class="ti ti-circle-check"></i><span>Finalizados</span><em>{{ kpis.finished }}</em></button>
        </div>
        <div class="ac-tk-side-sec">
            <small>Situação</small>
            {% for s in situations %}{% if s.key != 'finished' %}
                <button type="button" data-filter="sit:{{ s.key }}" title="{{ s.label }}"><i class="ac-tk-dot is-{{ s.tone }}"></i><span>{{ s.label }}</span><em>{{ s.count }}</em></button>
            {% endif %}{% endfor %}
        </div>
        <div class="ac-tk-side-sec">
            <small>Prioridade</small>
            {% for p in priorities %}
                <button type="button" data-filter="prio:{{ p.key }}" title="{{ p.label }}"><i class="ti ti-flag ac-tk-flag is-p{{ p.key }}"></i><span>{{ p.label }}</span><em>{{ p.count }}</em></button>
            {% endfor %}
        </div>
        <div class="ac-tk-side-sec">
            <small>Operação</small>
            <a href="{{ more_url }}" title="Problemas e mudanças"><i class="ti ti-layout-grid"></i><span>Problemas e mudanças</span></a>
        </div>
    </aside>
<div class="ac-app ac-sup ac-tk">
    <div class="ac-head">
        <div>
            <div class="ac-eyebrow">Ativa Central · Atendimento</div>
            <h1 class="ac-title">Chamados</h1>
            <div class="ac-subtitle">Fila de atendimento: o que está aberto, com quem está e o que está aguardando.</div>
        </div>
        <div class="ac-actions">
            {% if new_url %}
                <a class="ac-btn is-primary" href="{{ new_url }}"><i class="ti ti-plus"></i> Novo chamado</a>
            {% endif %}
        </div>
    </div>

    <div class="ac-sup-kpis ac-tk-kpis">
        <button type="button" class="ac-panel ac-sup-kpi ac-tk-kpi" data-filter="sit:waiting_tech">
            <span class="ac-sup-kpi-icon is-blue"><i class="ti ti-inbox"></i></span>
            <div><b>{{ kpis.new }}</b><small>novos, sem atendente</small></div>
        </button>
        <button type="button" class="ac-panel ac-sup-kpi ac-tk-kpi" data-filter="group:assigned">
            <span class="ac-sup-kpi-icon is-violet"><i class="ti ti-headset"></i></span>
            <div><b>{{ kpis.assigned }}</b><small>atribuídos{% if kpis.mine %} · {{ kpis.mine }} com você{% endif %}</small></div>
        </button>
        <button type="button" class="ac-panel ac-sup-kpi ac-tk-kpi" data-filter="group:waiting">
            <span class="ac-sup-kpi-icon is-orange"><i class="ti ti-hourglass"></i></span>
            <div><b>{{ kpis.waiting }}</b><small>aguardando</small></div>
        </button>
        <button type="button" class="ac-panel ac-sup-kpi ac-tk-kpi" data-filter="sit:finished">
            <span class="ac-sup-kpi-icon is-green"><i class="ti ti-circle-check"></i></span>
            <div><b>{{ kpis.finished }}</b><small>encerrados recentes</small></div>
        </button>
    </div>

    <div class="ac-panel ac-sup-list">
        <div class="ac-sup-toolbar ac-tk-toolbar">
            <label class="ac-sup-search">
                <i class="ti ti-search"></i>
                <input type="search" id="ac-list-search" placeholder="Buscar por número, título, usuário, categoria…">
            </label>
        </div>

        {% if tickets is empty %}
            <div class="ac-ptasks-empty"><i class="ti ti-ticket"></i><b>Nenhum chamado</b><span>Quando alguém abrir um chamado, ele aparece aqui.</span></div>
        {% else %}
            <div class="ac-tk-list">
                <div class="ac-tk-row ac-tk-headrow">
                    <span>Chamado</span><span>Requerente</span><span>Atendente</span><span>Situação</span><span></span>
                </div>
                {% for t in tickets %}
                    <a class="ac-tk-row ac-list-row" href="{{ t.url }}"
                       data-sit="{{ t.situation }}" data-prio="{{ min(5, max(2, t.priority)) }}" data-open="{{ t.open ? 1 : 0 }}" data-mine="{{ t.mine ? 1 : 0 }}"
                       data-search="{{ ('#' ~ t.id ~ ' ' ~ t.id ~ ' ' ~ t.name ~ ' ' ~ t.requester ~ ' ' ~ t.techs ~ ' ' ~ t.category)|lower }}">
                        <div class="ac-tk-main">
                            <b><span class="ac-tk-id">#{{ t.id }}</span> {{ t.name }}</b>
                            <small>
                                <span class="ac-tk-prio is-p{{ t.priority }}">{{ t.priority_label }}</span>
                                {% if t.category %}<span>{{ t.category }}</span>{% endif %}
                                <span title="{{ t.date }}"><i class="ti ti-clock"></i> {{ t.age }}</span>
                            </small>
                        </div>
                        <div class="ac-tk-person">{{ t.requester ?: '—' }}</div>
                        <div class="ac-tk-person {{ t.techs ? '' : 'is-empty' }}">{{ t.techs ?: 'Sem atendente' }}</div>
                        <span class="ac-tk-sit is-{{ t.sit_tone }}">{{ t.sit_label }}</span>
                        <i class="ti ti-chevron-right ac-sup-go"></i>
                    </a>
                {% endfor %}
            </div>
            <div class="ac-ptasks-empty" id="ac-list-none" hidden><i class="ti ti-search"></i><b>Nada encontrado</b><span>Tente outro termo ou filtro.</span></div>
            <div class="ac-tk-foot">Finalizados: mostra os {{ finished_limit }} mais recentes.</div>
        {% endif %}
    </div>
</div>
</div>
<script>
    (function () {
        var rows = Array.prototype.slice.call(document.querySelectorAll('.ac-tk-list .ac-list-row'));
        var search = document.getElementById('ac-list-search');
        var none = document.getElementById('ac-list-none');
        var filter = 'open';
        var groups = { assigned: ['in_progress', 'running'], waiting: ['waiting_user', 'waiting_approval', 'waiting_third'] };
        function match(r) {
            var sit = r.getAttribute('data-sit');
            if (filter === 'open') { return r.getAttribute('data-open') === '1'; }
            if (filter === 'mine') { return r.getAttribute('data-mine') === '1' && r.getAttribute('data-open') === '1'; }
            if (filter.indexOf('sit:') === 0) { return sit === filter.slice(4); }
            if (filter.indexOf('prio:') === 0) { return r.getAttribute('data-open') === '1' && r.getAttribute('data-prio') === filter.slice(5); }
            if (filter.indexOf('group:') === 0) { return groups[filter.slice(6)].indexOf(sit) !== -1; }
            return true;
        }
        function apply() {
            var q = (search && search.value || '').trim().toLowerCase();
            var shown = 0;
            rows.forEach(function (r) {
                var ok = match(r) && (!q || r.getAttribute('data-search').indexOf(q) !== -1);
                r.hidden = !ok;
                shown += ok ? 1 : 0;
            });
            if (none) { none.hidden = shown > 0; }
            document.querySelectorAll('[data-filter]').forEach(function (x) { x.classList.toggle('is-active', x.getAttribute('data-filter') === filter); });
            try { sessionStorage.setItem('ac-tk-filter', filter); } catch (e) {}
        }
        document.querySelectorAll('[data-filter]').forEach(function (b) {
            b.addEventListener('click', function () {
                // Clicar de novo no card ativo volta para todos os abertos.
                var f = b.getAttribute('data-filter');
                filter = filter === f ? 'open' : f;
                apply();
            });
        });
        if (search) { search.addEventListener('input', apply); }
        // Barra de filtros: recolhida (so icones) ou expandida; lembrada no navegador.
        var layout = document.getElementById('ac-tk-layout');
        try { if (localStorage.getItem('ac-tk-side') === 'open') { layout.classList.add('is-expanded'); } } catch (e) {}
        document.getElementById('ac-tk-side-toggle').addEventListener('click', function () {
            layout.classList.toggle('is-expanded');
            try { localStorage.setItem('ac-tk-side', layout.classList.contains('is-expanded') ? 'open' : 'closed'); } catch (e) {}
        });
        try { filter = sessionStorage.getItem('ac-tk-filter') || 'open'; } catch (e) {}
        apply();
    })();
</script>
