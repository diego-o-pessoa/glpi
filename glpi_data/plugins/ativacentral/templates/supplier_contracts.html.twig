{# Aba Contratos do fornecedor: lista vinculada que abre a tela completa do contrato. #}
<div class="ac-panel ac-ptasks">
    <div class="ac-ptasks-head">
        <div>
            <h2 class="ac-pnew-title"><i class="ti ti-file-certificate"></i> Contratos</h2>
            <div class="ac-pnew-hint">{{ contracts|length }} {{ contracts|length == 1 ? 'contrato' : 'contratos' }} · clique num contrato para abrir a ficha completa</div>
        </div>
        {% if can_update %}
            <div class="ac-actions">
                {% if existing is not empty %}
                    <button type="button" class="ac-btn" id="ac-cr-link-open"><i class="ti ti-link"></i> Vincular existente</button>
                {% endif %}
                {% if new_contract_url %}
                    <a class="ac-btn is-primary" href="{{ new_contract_url }}"><i class="ti ti-plus"></i> Novo contrato</a>
                {% endif %}
            </div>
        {% endif %}
    </div>

    {% if can_update and existing is not empty %}
        <form method="post" action="{{ action }}" class="ac-ct-link" id="ac-cr-link" hidden>
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf }}">
            <input type="hidden" name="contract_action" value="link">
            <select name="contracts_id" class="ac-pnew-input" required>
                <option value="">Escolha um contrato já cadastrado…</option>
                {% for e in existing %}<option value="{{ e.id }}">{{ e.label }}</option>{% endfor %}
            </select>
            <button type="submit" class="ac-btn is-primary"><i class="ti ti-link"></i> Vincular</button>
        </form>
    {% endif %}

    {% if contracts is empty %}
        <div class="ac-ptasks-empty">
            <i class="ti ti-file-certificate"></i>
            <b>Nenhum contrato ainda</b>
            <span>Cadastre os contratos com esse fornecedor para acompanhar vigência, documentos e renovação.</span>
        </div>
    {% else %}
        <div class="ac-cr-list">
            {% for c in contracts %}
                <div class="ac-cr-row ac-cr-row-split">
                    <a class="ac-cr-link" href="{{ c.url }}">
                        <span class="ac-sup-kpi-icon is-violet"><i class="ti ti-file-certificate"></i></span>
                        <div class="ac-cr-main">
                            <b>{{ c.name }}</b>
                            <small>
                                {% if c.num %}<span>Nº {{ c.num }}</span>{% endif %}
                                {% if c.type_label %}<span class="ac-ptask-type">{{ c.type_label }}</span>{% endif %}
                                {% if c.state_label %}<span>{{ c.state_label }}</span>{% endif %}
                            </small>
                        </div>
                        <div class="ac-cr-period">
                            <span><i class="ti ti-calendar"></i> {{ c.begin_text ?: '—' }} → {{ c.end_text ?: '—' }}</span>
                            <small>{{ c.duration > 0 ? c.duration ~ (c.duration == 1 ? ' mês' : ' meses') : 'Sem duração' }}{{ c.renewal_label ? ' · Renovação ' ~ c.renewal_label|lower : '' }}</small>
                        </div>
                        <span class="ac-cr-sit is-{{ c.situation.tone }}">{{ c.situation.label }}</span>
                    </a>
                    {% if can_update %}
                        <form method="post" action="{{ action }}" onsubmit="return confirm('Desvincular este contrato do fornecedor? O contrato continua cadastrado.');">
                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf }}">
                            <input type="hidden" name="contract_action" value="unlink">
                            <input type="hidden" name="link_id" value="{{ c.link_id }}">
                            <button type="submit" class="ac-docs-btn is-danger" title="Desvincular deste fornecedor"><i class="ti ti-unlink"></i></button>
                        </form>
                    {% else %}
                        <a class="ac-sup-go" href="{{ c.url }}" aria-label="Abrir contrato"><i class="ti ti-chevron-right"></i></a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% if can_update and existing is not empty %}
<script>
    (function () {
        var linkOpen = document.getElementById('ac-cr-link-open');
        if (linkOpen) {
            linkOpen.addEventListener('click', function () {
                var f = document.getElementById('ac-cr-link');
                f.hidden = !f.hidden;
                if (!f.hidden) {
                    var sel = f.querySelector('select');
                    if (sel) { sel.focus(); }
                }
            });
        }
    })();
</script>
{% endif %}
