{# Campos da gaveta de contrato (fornecedor e tela geral). #}
                <label class="ac-pnew-field">
                    <span class="ac-pnew-label">Nome <b>*</b></span>
                    <input type="text" name="name" class="ac-pnew-input" required maxlength="255" placeholder="Ex.: TOTVS PIX Cobrança">
                </label>
                <div class="ac-pnew-dates">
                    <label class="ac-pnew-field">
                        <span class="ac-pnew-label">Número</span>
                        <input type="text" name="num" class="ac-pnew-input" maxlength="255">
                    </label>
                    <label class="ac-pnew-field">
                        <span class="ac-pnew-label">Tipo</span>
                        <select name="contracttypes_id" class="ac-pnew-input">
                            <option value="0">—</option>
                            {% for k, v in contract_types %}<option value="{{ k }}">{{ v }}</option>{% endfor %}
                        </select>
                    </label>
                    <label class="ac-pnew-field">
                        <span class="ac-pnew-label">Status</span>
                        <select name="states_id" class="ac-pnew-input">
                            <option value="0">—</option>
                            {% for k, v in contract_states %}<option value="{{ k }}">{{ v }}</option>{% endfor %}
                        </select>
                    </label>
                    <label class="ac-pnew-field">
                        <span class="ac-pnew-label">Localização</span>
                        <select name="locations_id" class="ac-pnew-input">
                            <option value="0">—</option>
                            {% for k, v in contract_locations %}<option value="{{ k }}">{{ v }}</option>{% endfor %}
                        </select>
                    </label>
                </div>

                <h3 class="ac-cr-sub"><i class="ti ti-calendar"></i> Vigência</h3>
                <div class="ac-pnew-dates">
                    <label class="ac-pnew-field">
                        <span class="ac-pnew-label">Data inicial</span>
                        <input type="date" name="begin_date" class="ac-pnew-input">
                    </label>
                    <label class="ac-pnew-field">
                        <span class="ac-pnew-label">Duração (meses)</span>
                        <input type="number" name="duration" class="ac-pnew-input" min="0" max="120" step="1">
                    </label>
                    <label class="ac-pnew-field">
                        <span class="ac-pnew-label">Periodicidade (meses)</span>
                        <input type="number" name="periodicity" class="ac-pnew-input" min="0" max="120" step="1">
                    </label>
                    <label class="ac-pnew-field">
                        <span class="ac-pnew-label">Renovação</span>
                        <select name="renewal" class="ac-pnew-input">
                            {% for k, v in contract_renewals %}<option value="{{ k }}">{{ v }}</option>{% endfor %}
                        </select>
                    </label>
                </div>
                <div class="ac-pnew-hint" id="ac-cr-end"></div>

                <h3 class="ac-cr-sub"><i class="ti ti-bell"></i> Avisos</h3>
                <div class="ac-pnew-dates">
                    <label class="ac-pnew-field">
                        <span class="ac-pnew-label">Aviso prévio (meses)</span>
                        <input type="number" name="notice" class="ac-pnew-input" min="0" max="120" step="1">
                    </label>
                    <label class="ac-pnew-field">
                        <span class="ac-pnew-label">Avisos por e-mail</span>
                        <select name="alert" class="ac-pnew-input">
                            {% for k, v in contract_alerts %}<option value="{{ k }}">{{ v }}</option>{% endfor %}
                        </select>
                    </label>
                </div>
