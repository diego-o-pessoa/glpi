{# Fornecedor: novo / tela com abas e contatos. #}
<link rel="stylesheet" type="text/css" href="{{ css_url }}">
<div class="ac-app ac-pnew ac-pview ac-sup">
    <a class="ac-pview-back" href="{{ back }}"><i class="ti ti-arrow-left"></i> Voltar para Fornecedores</a>

    {% if is_new %}
        <div class="ac-head">
            <div>
                <div class="ac-eyebrow">Ativa Central · Fornecedores</div>
                <h1 class="ac-title">Novo fornecedor</h1>
                <div class="ac-subtitle">Cadastre a empresa. Contatos e contratos você adiciona depois, dentro dele.</div>
            </div>
        </div>
    {% else %}
        <div class="ac-panel ac-pview-hero">
            <div class="ac-pview-hero-main">
                <div class="ac-pview-badges">
                    {% if category %}<span class="ac-pview-tag is-state">{{ category }}</span>{% endif %}
                    <span class="ac-pview-tag {{ active ? 'is-green' : 'is-muted' }}">{{ active ? 'Ativo' : 'Inativo' }}</span>
                </div>
                <h1 class="ac-title">{{ title }}</h1>
                <div class="ac-pview-meta">
                    {% if header_phone %}<span><i class="ti ti-phone"></i> {{ header_phone }}</span>{% endif %}
                    {% if header_email %}<span><i class="ti ti-mail"></i> {{ header_email }}</span>{% endif %}
                </div>
            </div>
        </div>
    {% endif %}

    {% if error %}
        <div class="ac-pnew-error"><i class="ti ti-alert-circle"></i> {{ error }}</div>
    {% endif %}

    <div class="{{ is_new ? '' : 'ac-pview-layout' }}">
        {% if not is_new %}
            <nav class="ac-panel ac-pview-nav">
                {% for t in tabs %}
                    <a href="{{ t.url }}" class="ac-pview-nav-item {{ t.active ? 'is-active' : '' }}">
                        <i class="ti {{ t.icon }}"></i><span>{{ t.label }}</span>
                        {% if t.count > 0 %}<b>{{ t.count }}</b>{% endif %}
                    </a>
                {% endfor %}
            </nav>
        {% endif %}

        <div class="ac-pview-content">
            {% if tab_url is defined %}
                <div class="ac-panel ac-pview-glpi" id="ac-pview-tab" data-url="{{ tab_url }}">
                    <div class="ac-pview-loading"><span class="spinner-border spinner-border-sm"></span> Carregando…</div>
                </div>
                <script>
                    (function () {
                        var box = document.getElementById('ac-pview-tab');
                        $(box).load(box.getAttribute('data-url'), function (response, status) {
                            if (status === 'error') {
                                box.innerHTML = '<div class="ac-pnew-error"><i class="ti ti-alert-circle"></i> Não foi possível carregar esta aba. Atualize a página.</div>';
                            }
                        });
                    })();
                </script>
            {% elseif tab == 'contacts' %}
                {% include '@ativacentral/supplier_contacts.html.twig' %}
            {% elseif tab == 'contracts' %}
                {% include '@ativacentral/supplier_contracts.html.twig' %}
            {% else %}
                <form method="post" action="{{ action }}" class="ac-pnew-form" autocomplete="off" enctype="multipart/form-data">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf }}">
                    <input type="hidden" name="id" value="{{ id }}">
                    <button type="submit" name="save" value="1" tabindex="-1" aria-hidden="true" style="position: absolute; left: -9999px; width: 1px; height: 1px;"></button>
                    {% set ro = not can_update %}

                    <section class="ac-panel ac-pnew-card">
                        <h2 class="ac-pnew-title"><i class="ti ti-building-store"></i> Dados do fornecedor</h2>
                        <label class="ac-pnew-field">
                            <span class="ac-pnew-label">Nome <b>*</b></span>
                            <input type="text" name="name" value="{{ f_name }}" class="ac-pnew-input" required maxlength="255" placeholder="Ex.: TOTVS S/A" {{ ro ? 'readonly' : '' }}>
                        </label>
                        <div class="ac-pnew-dates">
                            <div class="ac-pnew-field">
                                <span class="ac-pnew-label">Categoria</span>
                                <div class="ac-pnew-glpi">{{ categories_html|raw }}</div>
                            </div>
                            <label class="ac-pnew-field">
                                <span class="ac-pnew-label">CNPJ</span>
                                <input type="text" name="registration_number" value="{{ f_registration_number }}" class="ac-pnew-input" maxlength="255" placeholder="00.000.000/0000-00" {{ ro ? 'readonly' : '' }}>
                            </label>
                        </div>
                        <label class="ac-sup-switch">
                            <input type="checkbox" name="is_active" value="1" {{ active ? 'checked' : '' }} {{ ro ? 'disabled' : '' }}>
                            <span></span> Fornecedor ativo
                        </label>

                        <h2 class="ac-pnew-title" style="margin-top: 6px;"><i class="ti ti-map-pin"></i> Endereço</h2>
                        <label class="ac-pnew-field">
                            <span class="ac-pnew-label">Endereço</span>
                            <input type="text" name="address" value="{{ f_address }}" class="ac-pnew-input" placeholder="Rua, número, bairro" {{ ro ? 'readonly' : '' }}>
                        </label>
                        <div class="ac-pnew-dates">
                            <label class="ac-pnew-field">
                                <span class="ac-pnew-label">Cidade</span>
                                <input type="text" name="town" value="{{ f_town }}" class="ac-pnew-input" {{ ro ? 'readonly' : '' }}>
                            </label>
                            <label class="ac-pnew-field">
                                <span class="ac-pnew-label">Estado</span>
                                <input type="text" name="state" value="{{ f_state }}" class="ac-pnew-input" {{ ro ? 'readonly' : '' }}>
                            </label>
                            <label class="ac-pnew-field">
                                <span class="ac-pnew-label">CEP</span>
                                <input type="text" name="postcode" value="{{ f_postcode }}" class="ac-pnew-input" {{ ro ? 'readonly' : '' }}>
                            </label>
                            <label class="ac-pnew-field">
                                <span class="ac-pnew-label">País</span>
                                <input type="text" name="country" value="{{ f_country }}" class="ac-pnew-input" {{ ro ? 'readonly' : '' }}>
                            </label>
                        </div>
                    </section>

                    <div class="ac-pnew-side">
                        <section class="ac-panel ac-pnew-card">
                            <h2 class="ac-pnew-title"><i class="ti ti-phone"></i> Contato da empresa</h2>
                            <label class="ac-pnew-field">
                                <span class="ac-pnew-label">Telefone</span>
                                <input type="text" name="phonenumber" value="{{ f_phonenumber }}" class="ac-pnew-input" {{ ro ? 'readonly' : '' }}>
                            </label>
                            <label class="ac-pnew-field">
                                <span class="ac-pnew-label">E-mail</span>
                                <input type="email" name="email" value="{{ f_email }}" class="ac-pnew-input" {{ ro ? 'readonly' : '' }}>
                            </label>
                            <label class="ac-pnew-field">
                                <span class="ac-pnew-label">Site</span>
                                <input type="text" name="website" value="{{ f_website }}" class="ac-pnew-input" placeholder="https://" {{ ro ? 'readonly' : '' }}>
                            </label>
                        </section>

                        <section class="ac-panel ac-pnew-card">
                            <h2 class="ac-pnew-title"><i class="ti ti-photo"></i> Imagens</h2>
                            {% if pictures is not empty %}
                                <div class="ac-sup-pics">
                                    {% for p in pictures %}<img src="{{ p }}" alt="">{% endfor %}
                                </div>
                            {% endif %}
                            {% if can_update %}<div class="ac-pnew-glpi">{{ pictures_html|raw }}</div>{% endif %}
                        </section>

                        {% if can_update %}
                            <div class="ac-pnew-submit">
                                {% if can_delete %}
                                    <button type="submit" name="delete" value="1" class="ac-btn ac-btn-danger" formnovalidate
                                            onclick="return confirm('Mover este fornecedor para a lixeira?');">
                                        <i class="ti ti-trash"></i> Excluir
                                    </button>
                                {% endif %}
                                <a class="ac-btn" href="{{ back }}">Cancelar</a>
                                <button type="submit" name="save" value="1" class="ac-btn is-primary">
                                    <i class="ti ti-check"></i> {{ is_new ? 'Criar fornecedor' : 'Salvar alterações' }}
                                </button>
                            </div>
                        {% endif %}
                    </div>
                </form>
            {% endif %}
        </div>
    </div>
</div>
