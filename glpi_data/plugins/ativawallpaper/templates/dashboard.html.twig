{% set style_labels = {'fill': 'Fill', 'fit': 'Fit', 'stretch': 'Stretch', 'center': 'Center', 'tile': 'Tile', 'span': 'Span'} %}
<div class="container-fluid ativa-wallpaper awp-shell"
     data-awp-overview
     data-endpoint="{{ urls.overview }}"
     data-action-url="{{ urls.action }}"
     data-server-epoch="{{ server_epoch }}">
  {{ include('@ativawallpaper/partials/header.html.twig', {active: 'overview', urls: urls, show_settings: rights.config_view, live: true}) }}

  {% if not enabled %}
    <div class="awp-alert is-warning" role="alert">
      <i class="ti ti-player-pause"></i>A distribuição está desativada. Os computadores mantêm o wallpaper atual.
    </div>
  {% endif %}
  <div class="awp-alert d-none" role="status" data-awp-message></div>

  <section class="awp-kpis" data-awp-section="kpis">
    {{ include('@ativawallpaper/overview/kpis.html.twig') }}
  </section>

  <div class="awp-main-grid {{ rights.publish ? '' : 'without-publish' }}">
    <section class="awp-card awp-current">
      <div class="awp-card-header">
        <h2 class="awp-card-title"><i class="ti ti-photo"></i>Wallpaper atual</h2>
        <span class="awp-badge {{ enabled ? 'is-green' : 'is-gray' }}"><i class="ti ti-point-filled"></i>{{ enabled ? 'Ativo' : 'Inativo' }}</span>
      </div>
      <div class="awp-card-body">
        {% if current %}
          <div class="awp-current-grid">
            <a class="awp-current-preview" href="{{ urls.image }}?id={{ current.id }}" target="_blank" rel="noopener" title="Abrir imagem em tamanho original">
              <img src="{{ urls.image }}?id={{ current.id }}&thumbnail=1" alt="Wallpaper {{ current.version }}">
            </a>
            <dl class="awp-details">
              <dt>Versão</dt><dd><code class="awp-pill">{{ current.version }}</code></dd>
              <dt>Publicado em</dt><dd>{{ current.published_at|formatted_datetime }}</dd>
              <dt>Por</dt><dd>{{ current.created_by_name }}</dd>
              <dt>Resolução</dt><dd>{{ current.width }}x{{ current.height }}</dd>
              <dt>Tamanho</dt><dd>{{ (current.filesize / 1048576)|number_format(2, ',', '.') }} MB</dd>
              <dt>SHA-256</dt>
              <dd class="awp-hash-row">
                <code class="awp-pill" title="{{ current.sha256 }}">{{ current.sha256|slice(0, 16) }}...</code>
                <button type="button" class="awp-icon-btn is-plain" data-awp-copy="{{ current.sha256 }}" title="Copiar SHA-256"><i class="ti ti-copy"></i></button>
              </dd>
              <dt>Modo</dt><dd>{{ style_labels[current.style] ?? current.style|capitalize }}</dd>
              <dt>Bloqueio</dt><dd>{{ current.lock_change ? 'Sim' : 'Não' }}</dd>
            </dl>
          </div>
        {% else %}
          <div class="awp-empty">
            <i class="ti ti-photo-off"></i>
            <p>Nenhum wallpaper foi publicado.</p>
            {% if rights.publish %}<small>Envie a primeira imagem em “Publicar novo wallpaper”.</small>{% endif %}
          </div>
        {% endif %}
      </div>
      {% if rights.publish or rights.config %}
        <div class="awp-card-actions">
          {% if rights.publish %}
            <button type="button" class="btn awp-btn-primary" data-awp-change-wallpaper>
              <i class="ti ti-upload"></i>Trocar wallpaper
            </button>
          {% endif %}
          {% if rights.publish and current %}
            <form method="post" action="{{ urls.action }}" data-awp-force-all>
              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
              <input type="hidden" name="action" value="force_all">
              {# Always available: it cancels the current cycle and starts a new one. #}
              <button class="btn awp-btn-success" type="submit">
                <i class="ti ti-device-desktop-check"></i>{{ enabled ? 'Aplicar novamente' : 'Ativar e aplicar' }}
              </button>
            </form>
          {% endif %}
          {% if rights.config %}
            <form method="post" action="{{ urls.action }}"
                  data-ativa-confirm="{{ enabled ? 'Desativar a distribuição? Os computadores mantêm o wallpaper atual.' : 'Ativar a distribuição do wallpaper?' }}">
              <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
              <input type="hidden" name="action" value="toggle">
              <input type="hidden" name="enabled" value="{{ enabled ? '0' : '1' }}">
              <button class="btn {{ enabled ? 'awp-btn-outline-warning' : 'awp-btn-outline-success' }}" type="submit">
                <i class="ti ti-power"></i>{{ enabled ? 'Desativar' : 'Ativar' }}
              </button>
            </form>
          {% endif %}
        </div>
      {% endif %}
    </section>

    {% if rights.publish %}
      <section class="awp-card awp-publish" id="awp-publish">
        <div class="awp-card-header">
          <h2 class="awp-card-title"><i class="ti ti-cloud-upload"></i>Publicar novo wallpaper</h2>
        </div>
        <form class="awp-card-body" method="post" action="{{ urls.action }}" enctype="multipart/form-data"
              data-ativa-upload-form data-max-bytes="{{ max_upload_mb * 1048576 }}">
          <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
          <input type="hidden" name="action" value="publish">

          <label class="awp-dropzone" data-awp-dropzone>
            <input class="awp-file-input" name="wallpaper" type="file" accept="image/jpeg,image/png,.jpg,.jpeg,.png" required data-ativa-image-input>
            <img class="d-none" alt="Pré-visualização da imagem selecionada" data-ativa-image-preview>
            <span class="awp-dropzone-empty" data-ativa-preview-empty>
              <i class="ti ti-cloud-upload"></i>
              <strong>Selecione uma imagem para enviar</strong>
              <span>Arraste e solte ou clique para selecionar</span>
              <small>Formatos aceitos: JPG, JPEG, PNG • Tamanho máximo: {{ max_upload_mb }} MB</small>
            </span>
          </label>
          <div class="invalid-feedback d-block" data-ativa-upload-error></div>

          <label class="form-label" for="awp-version-name">Nome / Versão</label>
          <input class="form-control" id="awp-version-name" name="version_name" maxlength="32"
                 pattern="[0-9A-Za-z][0-9A-Za-z._+\-]{0,31}" placeholder="Ex.: {{ 'now'|date('Ymd') }}-001"
                 title="Opcional. Letras, números, ponto, hífen ou sublinhado. Em branco, a versão é gerada automaticamente.">

          <div class="awp-form-row">
            <div>
              <label class="form-label" for="awp-style">Modo de exibição</label>
              <select class="form-select" id="awp-style" name="style">
                {% for value, label in style_labels %}
                  <option value="{{ value }}">{{ label }}</option>
                {% endfor %}
              </select>
            </div>
            <div>
              <label class="form-label" for="awp-lock">Aplicar bloqueio</label>
              <select class="form-select" id="awp-lock" name="lock_change" title="Impede o usuário de trocar o wallpaper">
                <option value="0">Não</option>
                <option value="1">Sim</option>
              </select>
            </div>
          </div>

          <button type="submit" class="btn awp-btn-primary w-100"><i class="ti ti-upload"></i>Enviar e publicar</button>
        </form>
      </section>
    {% endif %}

    <div class="awp-side">
      <section class="awp-card" data-awp-section="distribution">
        {{ include('@ativawallpaper/overview/distribution.html.twig') }}
      </section>
      <section class="awp-card" data-awp-section="activity">
        {{ include('@ativawallpaper/overview/activity.html.twig') }}
      </section>
    </div>
  </div>

  <section class="awp-card" id="awp-computers">
    <div class="awp-card-header">
      <h2 class="awp-card-title"><i class="ti ti-device-desktop"></i>Computadores</h2>
    </div>
    <form class="awp-filters" method="get" action="{{ urls.dashboard }}#awp-computers">
      <div class="awp-search">
        <i class="ti ti-search"></i>
        <input class="form-control" name="q" value="{{ filters.q }}" placeholder="Pesquisar por computador, usuário ou versão..." aria-label="Pesquisar computadores">
      </div>
      <div>
        <label class="form-label" for="awp-filter-status">Status</label>
        <select class="form-select" id="awp-filter-status" name="status">
          {% for value, label in statuses %}
            <option value="{{ value }}" {{ filters.status == value ? 'selected' : '' }}>{{ label }}</option>
          {% endfor %}
        </select>
      </div>
      <div>
        <label class="form-label" for="awp-filter-sort">Ordenar por</label>
        <select class="form-select" id="awp-filter-sort" name="sort">
          {% for value, definition in sorts %}
            <option value="{{ value }}" {{ filters.sort == value ? 'selected' : '' }}>{{ definition[0] }}</option>
          {% endfor %}
        </select>
      </div>
      <button type="submit" class="btn awp-btn-primary"><i class="ti ti-search"></i>Pesquisar</button>
    </form>
    <div data-awp-section="computers">
      {{ include('@ativawallpaper/overview/computers.html.twig') }}
    </div>
  </section>

  {# Logs of one computer (outside the live sections, so the periodic refresh keeps it open). #}
  <div class="awp-modal-layer" hidden data-awp-logs-modal data-endpoint="{{ urls.client_logs }}">
    <div class="awp-modal" role="dialog" aria-modal="true" aria-labelledby="awp-logs-title">
      <div class="awp-modal-header">
        <div class="awp-modal-heading">
          <span class="awp-modal-icon"><i class="ti ti-file-text"></i></span>
          <div>
            <h2 id="awp-logs-title">Logs do computador</h2>
            <p data-awp-logs-host></p>
          </div>
        </div>
        <button type="button" class="awp-modal-close" data-awp-logs-close aria-label="Fechar"><i class="ti ti-x"></i></button>
      </div>
      <div class="awp-alert d-none" role="status" data-awp-logs-status></div>
      <div class="awp-log-layout">
        <nav class="awp-log-menu" aria-label="Seções do log" data-awp-logs-menu></nav>
        <pre class="awp-log-content" data-awp-logs-content>Carregando...</pre>
      </div>
    </div>
  </div>
</div>
