<div class="container-fluid ativa-wallpaper">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
      <h1 class="mb-1"><i class="ti ti-photo me-2 text-primary"></i>Ativa Wallpaper</h1>
      <div class="text-muted">Gerenciamento centralizado dos wallpapers corporativos</div>
    </div>
    <nav class="btn-group" aria-label="Navegacao Ativa Wallpaper">
      <a class="btn btn-primary" href="{{ urls.dashboard }}"><i class="ti ti-dashboard me-1"></i>Dashboard</a>
      <a class="btn btn-outline-secondary" href="{{ urls.history }}"><i class="ti ti-history me-1"></i>Historico</a>
      <a class="btn btn-outline-secondary" href="{{ urls.events }}"><i class="ti ti-shield-check me-1"></i>Alteracoes</a>
      {% if rights.config %}<a class="btn btn-outline-secondary" href="{{ urls.updates }}"><i class="ti ti-cloud-download me-1"></i>Atualizacoes</a>{% endif %}
      {% if rights.config %}<a class="btn btn-outline-secondary" href="{{ urls.settings }}"><i class="ti ti-settings me-1"></i>Configuracoes</a>{% endif %}
    </nav>
  </div>

  {% if not enabled %}
    <div class="alert alert-warning d-flex align-items-center" role="alert">
      <i class="ti ti-player-pause me-2 fs-2"></i>
      <div>A distribuicao esta desativada. Os clientes manterao o wallpaper atual.</div>
    </div>
  {% endif %}

  <div class="row g-3 mb-4">
    <div class="col-xl-7">
      <section class="card h-100 shadow-sm">
        <div class="card-header d-flex align-items-center justify-content-between">
          <h2 class="card-title mb-0">Wallpaper atual</h2>
          <span class="badge {{ enabled ? 'bg-success' : 'bg-secondary' }}">{{ enabled ? 'Ativo' : 'Inativo' }}</span>
        </div>
        <div class="card-body">
          {% if current %}
            <div class="row g-4 align-items-center">
              <div class="col-lg-7">
                <img class="img-fluid rounded border ativa-current-preview" src="{{ urls.image }}?id={{ current.id }}&thumbnail=1" alt="Preview do wallpaper {{ current.version }}">
              </div>
              <div class="col-lg-5">
                <dl class="row mb-0 ativa-details">
                  <dt class="col-5">Versao</dt><dd class="col-7"><code>{{ current.version }}</code></dd>
                  <dt class="col-5">Publicado</dt><dd class="col-7">{{ current.published_at|formatted_datetime }}</dd>
                  <dt class="col-5">Por</dt><dd class="col-7">{{ current.created_by_name }}</dd>
                  <dt class="col-5">Resolucao</dt><dd class="col-7">{{ current.width }}x{{ current.height }}</dd>
                  <dt class="col-5">Tamanho</dt><dd class="col-7">{{ (current.filesize / 1048576)|number_format(2, ',', '.') }} MB</dd>
                  <dt class="col-5">SHA-256</dt><dd class="col-7"><code class="ativa-hash" title="{{ current.sha256 }}">{{ current.sha256|slice(0, 16) }}...</code></dd>
                  <dt class="col-5">Modo</dt><dd class="col-7">{{ current.style|capitalize }}</dd>
                  <dt class="col-5">Bloqueio</dt><dd class="col-7">{{ current.lock_change ? 'Sim' : 'Nao' }}</dd>
                </dl>
              </div>
            </div>
          {% else %}
            <div class="empty py-5 text-center">
              <i class="ti ti-photo-off fs-1 text-muted"></i>
              <p class="mt-3 mb-0">Nenhum wallpaper foi publicado.</p>
            </div>
          {% endif %}
        </div>
        {% if rights.publish or rights.config %}
          <div class="card-footer d-flex flex-wrap gap-2">
            {% if rights.publish %}
              <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#ativa-upload-modal">
                <i class="ti ti-upload me-1"></i>Alterar wallpaper
              </button>
            {% endif %}
            {% if rights.publish and current %}
              <form method="post" action="{{ urls.action }}" data-ativa-force-all>
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="action" value="force_all">
                <button class="btn btn-success" type="submit" {{ rollout and rollout.active ? 'disabled' : '' }}>
                  <i class="ti {{ rollout and rollout.active ? 'ti-loader-2 ativa-spin' : 'ti-device-desktop-check' }} me-1"></i>{{ rollout and rollout.active ? 'Aplicacao em andamento' : (enabled ? 'Aplicar em todos' : 'Ativar e aplicar em todos') }}
                </button>
              </form>
            {% endif %}
            {% if rights.config %}
              <form method="post" action="{{ urls.action }}">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="action" value="toggle">
                <input type="hidden" name="enabled" value="{{ enabled ? '0' : '1' }}">
                <button class="btn btn-outline-{{ enabled ? 'warning' : 'success' }}" type="submit">
                  <i class="ti ti-power me-1"></i>{{ enabled ? 'Desativar' : 'Ativar' }}
                </button>
              </form>
            {% endif %}
          </div>
        {% endif %}
      </section>
    </div>

    <div class="col-xl-5">
      <section class="card h-100 shadow-sm">
        <div class="card-header"><h2 class="card-title mb-0">Clientes Ativa Wallpaper</h2></div>
        <div class="card-body">
          <div class="display-5 fw-bold mb-3">{{ summary.managed }}</div>
          {% if summary.managed == 0 %}
            <div class="alert alert-info small">
              Computadores inventariados pelo GLPI somente aparecem aqui depois
              que o AtivaWallpaperClient for instalado e registrado neles.
              {% if rights.config %}<a href="{{ urls.settings }}">Abrir configuracoes de implantacao</a>.{% endif %}
            </div>
          {% endif %}
          <div class="row g-2">
            <div class="col-6"><div class="ativa-stat border-success"><span>Atualizados</span><strong>{{ summary.updated }}</strong></div></div>
            <div class="col-6"><div class="ativa-stat border-warning"><span>Pendentes</span><strong>{{ summary.pending }}</strong></div></div>
            <div class="col-6"><div class="ativa-stat border-secondary"><span>Offline</span><strong>{{ summary.offline }}</strong></div></div>
            <div class="col-6"><div class="ativa-stat border-danger"><span>Erro</span><strong>{{ summary.errors }}</strong></div></div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <section class="card shadow-sm mb-4 {{ rollout ? '' : 'd-none' }}"
           data-ativa-rollout
           data-progress-url="{{ urls.progress }}"
           data-active="{{ rollout and rollout.active ? '1' : '0' }}"
           data-monitoring="{{ rollout and rollout.monitoring ? '1' : '0' }}">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
      <div>
        <h2 class="card-title mb-0">Ciclo de sincronizacao e aplicacao</h2>
        <div class="small text-muted" data-rollout-version>
          {% if rollout %}Versao {{ rollout.version }} · iniciada em {{ rollout.started_at }}{% endif %}
        </div>
      </div>
      <span class="badge {{ rollout and rollout.phase == 'waiting' ? 'bg-warning' : (rollout and rollout.error > 0 ? 'bg-danger' : (rollout and rollout.phase in ['applying', 'monitoring'] ? 'bg-primary' : 'bg-success')) }}"
            data-rollout-state>
        {% if rollout and rollout.phase == 'waiting' %}Aguardando cliente{% elseif rollout and rollout.phase == 'applying' %}Aplicando{% elseif rollout and rollout.phase == 'monitoring' %}Monitorando{% elseif rollout and rollout.complete %}{{ rollout.error > 0 ? 'Concluida com erros' : 'Aplicado' }}{% else %}Em andamento{% endif %}
      </span>
    </div>
    <div class="card-body">
      <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
        <strong data-rollout-label>
          {% if rollout and rollout.phase in ['waiting', 'monitoring'] %}
            Proxima verificacao: {{ rollout.next_hostname ?: 'aguardando horario do cliente' }}
          {% elseif rollout %}
            {{ rollout.processed }} de {{ rollout.total }} computador(es) processado(s)
          {% endif %}
        </strong>
        <span class="text-muted" data-rollout-percentage>
          {% if rollout and rollout.phase in ['waiting', 'monitoring'] and rollout.countdown_seconds is not null %}{{ '%02d:%02d'|format((rollout.countdown_seconds / 60)|round(0, 'floor'), rollout.countdown_seconds % 60) }}{% else %}{{ rollout ? (rollout.percentage|number_format(1, ',', '.') ~ '%') : '0%' }}{% endif %}
        </span>
      </div>
      <div class="progress ativa-rollout-progress" role="progressbar"
           aria-valuenow="{{ rollout and rollout.phase in ['waiting', 'monitoring'] ? rollout.countdown_percentage : (rollout ? rollout.percentage : 0) }}" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar progress-bar-striped {{ rollout and rollout.phase == 'applying' ? 'progress-bar-animated' : '' }} {{ rollout and rollout.completed_with_error ? 'bg-warning' : (rollout and rollout.phase in ['waiting', 'monitoring'] ? 'bg-primary' : 'bg-success') }}"
             data-rollout-bar style="width: {{ rollout and rollout.phase in ['waiting', 'monitoring'] ? rollout.countdown_percentage : (rollout ? rollout.percentage : 0) }}%"></div>
      </div>
      <div class="ativa-rollout-current mt-3" data-rollout-current>
        {% if rollout and rollout.applying > 0 %}Aplicando agora...{% elseif rollout and rollout.countdown_seconds is not null %}Aguardando {{ rollout.next_hostname }} executar o cliente em {{ rollout.countdown_seconds }} segundo(s)...{% elseif rollout and rollout.complete %}Monitoramento continuo ativo.{% else %}Preparando aplicacao...{% endif %}
      </div>
      <div class="small text-muted mt-1" data-rollout-last-update>Conectando ao monitoramento em tempo real...</div>
      <div class="row g-3 mt-2 ativa-rollout-counts">
        <div class="col-6 col-md-3"><span class="text-muted">Aguardando</span><strong data-rollout-pending>{{ rollout ? rollout.pending : 0 }}</strong></div>
        <div class="col-6 col-md-3"><span class="text-muted">Aplicando</span><strong data-rollout-applying>{{ rollout ? rollout.applying : 0 }}</strong></div>
        <div class="col-6 col-md-3"><span class="text-muted">Concluidos</span><strong class="text-success" data-rollout-success>{{ rollout ? rollout.success : 0 }}</strong></div>
        <div class="col-6 col-md-3"><span class="text-muted">Erros</span><strong class="text-danger" data-rollout-error>{{ rollout ? rollout.error : 0 }}</strong></div>
      </div>
      <div class="ativa-rollout-machines mt-3">
        <div class="small fw-semibold mb-1" data-rollout-machines-title>Computadores desta aplicacao</div>
        <ul class="list-unstyled mb-0" data-rollout-machines>
          {% if rollout %}
            {% for machine in rollout.machines %}
              <li class="ativa-rollout-machine" data-status="{{ machine.status }}">
                <i class="ti {{ machine.status == 'success' ? 'ti-circle-check text-success' : (machine.status == 'error' ? 'ti-alert-circle text-danger' : (machine.status == 'applying' ? 'ti-loader-2 text-primary ativa-spin' : 'ti-clock text-warning')) }}"></i>
                <strong>{{ machine.hostname }}</strong>
                <span class="text-muted">— {{ {'pending':'aguardando consulta','applying':'aplicando agora','success':'concluido','error':'erro'}[machine.status] }}</span>
                {% if machine.last_error %}<div class="small text-danger ms-4">{{ machine.last_error }}</div>{% endif %}
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>
      <div class="mt-3">
        <div class="small fw-semibold mb-1">Atividade em tempo real</div>
        <ol class="ativa-rollout-events small mb-0" data-rollout-events aria-live="polite"></ol>
      </div>
    </div>
  </section>

  <section class="card shadow-sm">
    <div class="card-header"><h2 class="card-title mb-0">Status dos computadores</h2></div>
    <div class="card-body border-bottom">
      <form method="get" action="{{ urls.dashboard }}" class="row g-2 align-items-end">
        <div class="col-md-5">
          <label class="form-label" for="ativa-search">Pesquisar</label>
          <input class="form-control" id="ativa-search" name="q" value="{{ filters.q }}" placeholder="Hostname, usuario ou versao">
        </div>
        <div class="col-md-3">
          <label class="form-label" for="ativa-status">Status</label>
          <select class="form-select" id="ativa-status" name="status">
            {% for value, label in {'all':'Todos','updated':'Atualizados','pending':'Pendentes','offline':'Offline','error':'Erro'} %}
              <option value="{{ value }}" {{ filters.status == value ? 'selected' : '' }}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="ativa-sort">Ordenar</label>
          <select class="form-select" id="ativa-sort" name="sort">
            {% for value, label in {'last_check':'Ultimo contato','hostname':'Computador','username':'Usuario','wallpaper_version':'Wallpaper','client_version':'Cliente','status':'Status'} %}
              <option value="{{ value }}" {{ filters.sort == value ? 'selected' : '' }}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-1">
          <label class="form-label" for="ativa-direction">Direcao</label>
          <select class="form-select" id="ativa-direction" name="direction">
            <option value="desc" {{ filters.direction == 'desc' ? 'selected' : '' }}>Desc</option>
            <option value="asc" {{ filters.direction == 'asc' ? 'selected' : '' }}>Asc</option>
          </select>
        </div>
        <div class="col-md-1"><button class="btn btn-primary w-100" type="submit"><i class="ti ti-search"></i><span class="visually-hidden">Filtrar</span></button></div>
      </form>
    </div>
    <div class="table-responsive">
      <table class="table table-hover table-vcenter mb-0">
        <thead><tr>
          <th>Computador</th><th>Usuario</th><th>Wallpaper</th><th>Cliente</th><th>Ultimo contato</th><th>Ultima aplicacao</th><th>Status</th><th>Erro</th>{% if rights.clients %}<th class="text-end">Acoes</th>{% endif %}
        </tr></thead>
        <tbody>
        {% for client in clients.rows %}
          {% set badge = {'updated':'success','pending':'warning','offline':'secondary','error':'danger'}[client.computed_status] %}
          {% set label = {'updated':'Atualizado','pending':'Pendente','offline':'Offline','error':'Erro'}[client.computed_status] %}
          <tr>
            <td><strong>{{ client.hostname }}</strong>{% if client.computers_id %}<div><a class="small" href="{{ config('root_doc') }}/front/computer.form.php?id={{ client.computers_id }}">Abrir computador #{{ client.computers_id }}</a></div>{% else %}<div class="small text-muted">Aguardando reconciliacao</div>{% endif %}</td>
            <td>{{ client.username ?: '-' }}</td>
            <td><code>{{ client.wallpaper_version ?: '-' }}</code></td>
            <td>{{ client.client_version }}</td>
            <td>{{ client.last_check ? client.last_check|formatted_datetime : '-' }}</td>
            <td>{{ client.last_apply ? client.last_apply|formatted_datetime : '-' }}</td>
            <td><span class="badge bg-{{ badge }}">{{ label }}</span>{% if client.force_reapply %}<div class="small text-primary mt-1">Reaplicacao solicitada</div>{% endif %}</td>
            <td class="ativa-error" title="{{ client.last_error ?: '' }}">{{ client.last_error ?: '-' }}</td>
            {% if rights.clients %}
              <td class="text-end text-nowrap">
                <form class="d-inline" method="post" action="{{ urls.action }}">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="action" value="force"><input type="hidden" name="id" value="{{ client.id }}">
                  <button class="btn btn-sm btn-outline-primary" title="Forcar nova sincronizacao"><i class="ti ti-refresh"></i></button>
                </form>
                <form class="d-inline" method="post" action="{{ urls.action }}" data-ativa-confirm="Revogar este cliente? Ele precisara ser registrado novamente.">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="action" value="revoke"><input type="hidden" name="id" value="{{ client.id }}">
                  <button class="btn btn-sm btn-outline-danger" title="Revogar cliente"><i class="ti ti-ban"></i></button>
                </form>
              </td>
            {% endif %}
          </tr>
        {% else %}
          <tr><td colspan="9" class="text-center text-muted py-5">Nenhum cliente encontrado.</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
      <span class="text-muted">{{ clients.total }} registro(s)</span>
      <nav><ul class="pagination mb-0">
        <li class="page-item {{ clients.page <= 1 ? 'disabled' : '' }}"><a class="page-link" href="{{ urls.dashboard }}?page={{ clients.page - 1 }}&q={{ filters.q|url_encode }}&status={{ filters.status }}&sort={{ filters.sort }}&direction={{ filters.direction }}">Anterior</a></li>
        <li class="page-item disabled"><span class="page-link">{{ clients.page }} / {{ clients.pages }}</span></li>
        <li class="page-item {{ clients.page >= clients.pages ? 'disabled' : '' }}"><a class="page-link" href="{{ urls.dashboard }}?page={{ clients.page + 1 }}&q={{ filters.q|url_encode }}&status={{ filters.status }}&sort={{ filters.sort }}&direction={{ filters.direction }}">Proxima</a></li>
      </ul></nav>
    </div>
  </section>
</div>

{% if rights.publish %}
<div class="modal fade" id="ativa-upload-modal" tabindex="-1" aria-labelledby="ativa-upload-title" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
    <form method="post" action="{{ urls.action }}" enctype="multipart/form-data" data-ativa-upload-form data-max-bytes="{{ max_upload_mb * 1048576 }}">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="action" value="publish">
      <div class="modal-header"><h2 class="modal-title" id="ativa-upload-title">Publicar wallpaper</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div>
      <div class="modal-body">
        <div class="row g-4">
          <div class="col-md-7">
            <label class="form-label" for="ativa-wallpaper-file">Imagem JPG ou PNG (maximo {{ max_upload_mb }} MB)</label>
            <input class="form-control" id="ativa-wallpaper-file" name="wallpaper" type="file" accept="image/jpeg,image/png,.jpg,.jpeg,.png" required data-ativa-image-input>
            <div class="invalid-feedback" data-ativa-upload-error></div>
            <div class="ativa-preview mt-3"><img class="img-fluid rounded border d-none" alt="Preview da imagem selecionada" data-ativa-image-preview><div class="text-muted text-center py-5" data-ativa-preview-empty>Selecione uma imagem para visualizar.</div></div>
          </div>
          <div class="col-md-5">
            <label class="form-label" for="ativa-style">Modo de ajuste</label>
            <select class="form-select mb-3" id="ativa-style" name="style">
              <option value="fill">Preencher / Fill</option><option value="fit">Ajustar / Fit</option><option value="stretch">Esticar / Stretch</option><option value="center">Centralizar / Center</option><option value="tile">Lado a lado / Tile</option><option value="span">Span</option>
            </select>
            <label class="form-check"><input class="form-check-input" type="checkbox" name="lock_change" value="1"><span class="form-check-label">Impedir usuario de alterar wallpaper</span></label>
            <p class="small text-muted mt-2">Desativado por padrao. O cliente nao sobrescreve politicas preexistentes.</p>
          </div>
        </div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary"><i class="ti ti-send me-1"></i>Publicar wallpaper</button></div>
    </form>
  </div></div>
</div>
{% endif %}
