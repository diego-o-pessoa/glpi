<div class="container-fluid ativa-wallpaper">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div><h1 class="mb-1"><i class="ti ti-history me-2 text-primary"></i>Historico</h1><div class="text-muted">Versoes preservadas e trilha administrativa</div></div>
    <nav class="btn-group"><a class="btn btn-outline-secondary" href="{{ urls.dashboard }}">Dashboard</a><a class="btn btn-primary" href="{{ urls.history }}">Historico</a>{% if can_config %}<a class="btn btn-outline-secondary" href="{{ urls.settings }}">Configuracoes</a>{% endif %}</nav>
  </div>

  <div class="row g-3 mb-4">
    {% for wallpaper in wallpapers %}
      <div class="col-md-6 col-xl-4"><article class="card h-100 shadow-sm {{ wallpaper.is_current ? 'border-success' : '' }}">
        <img class="card-img-top ativa-history-preview" src="{{ urls.image }}?id={{ wallpaper.id }}&thumbnail=1" alt="Preview {{ wallpaper.version }}">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2"><h2 class="h4 mb-0"><code>{{ wallpaper.version }}</code></h2><span class="badge {{ wallpaper.is_current ? 'bg-success' : 'bg-secondary' }}">{{ wallpaper.is_current ? 'Atual' : 'Anterior' }}</span></div>
          <dl class="row small mb-0"><dt class="col-4">Publicado</dt><dd class="col-8">{{ wallpaper.published_at|formatted_datetime }}</dd><dt class="col-4">Usuario</dt><dd class="col-8">{{ wallpaper.created_by_name }}</dd><dt class="col-4">Resolucao</dt><dd class="col-8">{{ wallpaper.width }}x{{ wallpaper.height }}</dd><dt class="col-4">Estilo</dt><dd class="col-8">{{ wallpaper.style }}</dd><dt class="col-4">SHA-256</dt><dd class="col-8"><code title="{{ wallpaper.sha256 }}">{{ wallpaper.sha256|slice(0, 14) }}...</code></dd></dl>
        </div>
        {% if can_publish and not wallpaper.is_current %}<div class="card-footer"><form method="post" action="{{ urls.action }}" data-ativa-confirm="Tornar esta versao atual? Os clientes detectarao uma nova revisao."><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="action" value="rollback"><input type="hidden" name="id" value="{{ wallpaper.id }}"><button class="btn btn-outline-primary w-100" type="submit"><i class="ti ti-restore me-1"></i>Tornar esta versao atual</button></form></div>{% endif %}
      </article></div>
    {% else %}
      <div class="col-12"><div class="card"><div class="card-body text-center text-muted py-5">Nenhuma versao publicada.</div></div></div>
    {% endfor %}
  </div>
  <nav class="mb-4"><ul class="pagination justify-content-center"><li class="page-item {{ page <= 1 ? 'disabled' : '' }}"><a class="page-link" href="{{ urls.history }}?page={{ page - 1 }}">Anterior</a></li><li class="page-item disabled"><span class="page-link">{{ page }} / {{ pages }}</span></li><li class="page-item {{ page >= pages ? 'disabled' : '' }}"><a class="page-link" href="{{ urls.history }}?page={{ page + 1 }}">Proxima</a></li></ul></nav>

  <section class="card shadow-sm"><div class="card-header"><h2 class="card-title mb-0">Auditoria administrativa</h2></div><div class="table-responsive"><table class="table table-striped table-vcenter mb-0"><thead><tr><th>Data</th><th>Usuario</th><th>Acao</th><th>Alvo</th><th>IP</th><th>Antes</th><th>Depois</th></tr></thead><tbody>
    {% for audit in audits %}<tr><td>{{ audit.created_at|formatted_datetime }}</td><td>{{ audit.user_name }}</td><td><code>{{ audit.action }}</code></td><td>{{ audit.target_type ?: '-' }}{% if audit.target_id %} #{{ audit.target_id }}{% endif %}</td><td>{{ audit.ip_address ?: '-' }}</td><td class="ativa-json">{{ audit.old_value ?: '-' }}</td><td class="ativa-json">{{ audit.new_value ?: '-' }}</td></tr>{% else %}<tr><td colspan="7" class="text-center text-muted py-4">Nenhum evento registrado.</td></tr>{% endfor %}
  </tbody></table></div></section>
</div>
