{#
  Verification cycle (src/MonitorCycle.php). Countdowns carry a Unix timestamp in
  data-awp-countdown and are ticked every second by the page script, so this HTML only
  changes when the cycle itself changes.
#}
{% set waiting = cycle.phase == 'waiting' %}
<div class="awp-card-header">
  <h2 class="awp-card-title"><i class="ti ti-chart-bar"></i>Distribuição e monitoramento</h2>
  {% if waiting %}
    <span class="awp-badge is-green"><i class="ti ti-circle-check"></i>Concluído</span>
  {% else %}
    <span class="awp-badge is-yellow"><i class="ti ti-loader-2 ativa-spin"></i>Analisando</span>
  {% endif %}
</div>
<div class="awp-card-body">
  <div class="awp-progress-head">
    <strong>
      {% if waiting %}
        {{ cycle.total }} de {{ cycle.total }} computadores analisados
      {% elseif cycle.total == 0 %}
        Aguardando os computadores se conectarem
      {% elseif cycle.current %}
        Analisando {{ cycle.analyzed + 1 }} de {{ cycle.total }} computadores
      {% else %}
        {{ cycle.analyzed }} de {{ cycle.total }} computadores analisados
      {% endif %}
    </strong>
    <span class="awp-progress-value {{ waiting ? '' : 'is-analyzing' }}">
      {% if waiting %}
        <span data-awp-countdown="{{ cycle.countdown_until }}">--:--</span> para começar
      {% elseif cycle.countdown_until %}
        <span data-awp-countdown="{{ cycle.countdown_until }}">--:--</span> para o próximo
      {% else %}
        {{ cycle.percentage|number_format(0, ',', '.') }}%
      {% endif %}
    </span>
  </div>
  <div class="awp-progress {{ waiting ? 'is-complete' : 'is-analyzing' }}" role="progressbar"
       aria-valuenow="{{ cycle.percentage }}" aria-valuemin="0" aria-valuemax="100">
    <span style="width: {{ cycle.percentage }}%"></span>
  </div>
  <div class="awp-rollout-line {{ waiting ? 'is-complete' : '' }}">
    {% if waiting %}
      <i class="ti ti-circle-check"></i>Verificação concluída em todos os computadores. Nova análise a cada {{ cycle.wait_seconds }} s.
    {% elseif cycle.current %}
      <i class="ti ti-loader-2 ativa-spin"></i>{{ cycle.current.hostname }}: {{ cycle.current.applying ? 'aplicando o wallpaper' : 'verificando o wallpaper' }}
    {% elseif cycle.next %}
      <i class="ti ti-clock"></i>Próximo: {{ cycle.next.hostname }}
    {% else %}
      <i class="ti ti-clock"></i>Nenhum computador ativo no momento
    {% endif %}
  </div>

  <div class="awp-mini-stats">
    <div class="awp-mini is-green"><i class="ti ti-circle-check-filled"></i><span>Atualizados</span><strong>{{ summary.updated }}</strong></div>
    <div class="awp-mini is-yellow"><i class="ti ti-clock-filled"></i><span>Pendentes</span><strong>{{ summary.pending }}</strong></div>
    <div class="awp-mini is-gray"><i class="ti ti-wifi-off"></i><span>Offline</span><strong>{{ summary.offline }}</strong></div>
    <div class="awp-mini is-red"><i class="ti ti-alert-circle-filled"></i><span>Erros</span><strong>{{ summary.errors }}</strong></div>
  </div>

  <div class="awp-distribution-footer">
    <span class="text-muted"><i class="ti ti-clock me-1"></i>{{ last_check_age }}</span>
  </div>
</div>
