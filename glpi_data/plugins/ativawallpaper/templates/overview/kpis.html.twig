{# Quem so ve a Visao geral nao abre o Historico: o cartao nao vira link. #}
<{{ limited ? 'div' : 'a' }} class="awp-kpi" {% if not limited %}href="{{ urls.history }}"{% endif %}>
  <span class="awp-kpi-icon"><i class="ti ti-photo"></i></span>
  <span class="awp-kpi-text">
    <span class="awp-kpi-label">Wallpaper ativo</span>
    <span class="awp-kpi-value awp-kpi-version">{{ current ? current.version : '—' }}</span>
    <span class="awp-kpi-note">{{ current ? 'Publicado em ' ~ (current.published_at|formatted_datetime|split(' ')|first) : 'Nenhum wallpaper publicado' }}</span>
  </span>
  {% if not limited %}<i class="ti ti-chevron-right awp-kpi-arrow"></i>{% endif %}
</{{ limited ? 'div' : 'a' }}>
<a class="awp-kpi" href="{{ urls.dashboard }}?status=all#awp-computers">
  <span class="awp-kpi-icon"><i class="ti ti-device-desktop"></i></span>
  <span class="awp-kpi-text">
    <span class="awp-kpi-label">Computadores gerenciados</span>
    <span class="awp-kpi-value">{{ summary.managed }}</span>
  </span>
  <i class="ti ti-chevron-right awp-kpi-arrow"></i>
</a>
<a class="awp-kpi is-green" href="{{ urls.dashboard }}?status=updated#awp-computers">
  <span class="awp-kpi-icon"><i class="ti ti-circle-check-filled"></i></span>
  <span class="awp-kpi-text">
    <span class="awp-kpi-label">Atualizados</span>
    <span class="awp-kpi-value">{{ summary.updated }}</span>
    <span class="awp-kpi-note">Com o wallpaper atual</span>
  </span>
  <span class="awp-kpi-percent">{{ summary.percentage|number_format(0, ',', '.') }}%</span>
  <i class="ti ti-chevron-right awp-kpi-arrow"></i>
</a>
<a class="awp-kpi {{ summary.outdated > 0 ? 'is-orange' : 'is-gray' }}" href="{{ urls.dashboard }}?status=outdated#awp-computers">
  <span class="awp-kpi-icon"><i class="ti ti-refresh-alert"></i></span>
  <span class="awp-kpi-text">
    <span class="awp-kpi-label">Desatualizados</span>
    <span class="awp-kpi-value">{{ summary.outdated }}</span>
    <span class="awp-kpi-note">Ainda sem o wallpaper atual</span>
  </span>
  <span class="awp-kpi-percent">{{ outdated_percentage|number_format(0, ',', '.') }}%</span>
  <i class="ti ti-chevron-right awp-kpi-arrow"></i>
</a>
