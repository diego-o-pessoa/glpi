{% set badges = {'updated': ['Atualizado', 'is-green'], 'pending': ['Pendente', 'is-yellow'], 'offline': ['Offline', 'is-gray'], 'error': ['Erro', 'is-red'], 'revoked': ['Revogado', 'is-red']} %}
{% set query = {q: filters.q, status: filters.status, sort: filters.sort, direction: filters.direction} %}
{% if revoked_count > 0 and filters.status != 'revoked' %}
  <div class="awp-alert is-warning awp-table-alert" role="status">
    <i class="ti ti-ban"></i>
    <span>
      {{ revoked_count }} computador(es) revogado(s) no Ativa Wallpaper: não recebem wallpaper nem aparecem nos indicadores até serem registrados de novo
      (<strong>Reinstalar</strong> no Ativa Updater).
      <a href="{{ urls.dashboard }}?status=revoked#awp-computers">Ver revogados</a>
    </span>
  </div>
{% endif %}
<div class="table-responsive">
  <table class="awp-table">
    <thead>
      <tr>
        <th>Computador</th>
        <th>Usuário</th>
        <th>Wallpaper</th>
        <th>Cliente</th>
        <th>Último contato</th>
        <th>Última aplicação</th>
        <th>Status</th>
        <th class="text-end">Ações</th>
      </tr>
    </thead>
    <tbody>
    {% for client in clients.rows %}
      {% set badge = badges[client.computed_status] %}
      <tr class="{{ client.computed_status in ['error', 'revoked'] ? 'is-error' : '' }}">
        <td>
          {% if client.computers_id %}
            <a class="awp-host-link" href="{{ urls.computer }}?id={{ client.computers_id }}" title="Abrir o computador no inventário do GLPI"><strong>{{ client.hostname }}</strong></a>
          {% else %}
            <strong>{{ client.hostname }}</strong>
          {% endif %}
        </td>
        <td>{{ client.username ?: '—' }}</td>
        <td>{% if client.wallpaper_version %}<code class="awp-pill">{{ client.wallpaper_version }}</code>{% else %}—{% endif %}</td>
        <td>{{ client.client_version }}</td>
        <td>{{ client.last_check ? client.last_check|formatted_datetime : '—' }}</td>
        <td>{{ client.last_apply ? client.last_apply|formatted_datetime : '—' }}</td>
        <td>
          <span class="awp-badge {{ badge[1] }}">{{ badge[0] }}</span>
          {% if client.force_reapply %}<small class="awp-row-note">Reaplicação solicitada</small>{% endif %}
          {% if client.computed_status == 'revoked' %}
            <small class="awp-row-note is-error" title="{{ client.last_error ?: 'Revogado no painel' }}">Revogado em {{ client.revoked_at|formatted_datetime }}</small>
          {% elseif client.computed_status == 'error' and client.last_error %}
            <small class="awp-row-note is-error" title="{{ client.last_error }}">{{ client.last_error }}</small>
          {% endif %}
          {% if client.computed_status in ['offline', 'revoked'] and client.updater and client.updater.online %}
            <small class="awp-row-note" title="O serviço Ativa Unified Updater deste computador fez contato há {{ (client.updater.age_seconds / 60)|round(0, 'floor') }} min">
              Computador online no Ativa Updater — o Wallpaper Client não está reportando
            </small>
          {% endif %}
        </td>
        <td class="text-end">
          <span class="awp-row-actions">
            <button type="button" class="awp-icon-btn" data-awp-client-logs data-id="{{ client.id }}" data-hostname="{{ client.hostname }}"
                    title="Ver os logs deste computador (erros como HTTP 404)"><i class="ti ti-file-text"></i></button>
            {% if rights.clients and client.computed_status != 'revoked' %}
              <button type="button" class="awp-icon-btn" data-awp-client-action="force" data-id="{{ client.id }}" title="Forçar nova aplicação neste computador"><i class="ti ti-refresh"></i></button>
              <button type="button" class="awp-icon-btn is-danger" data-awp-client-action="revoke" data-id="{{ client.id }}"
                      data-confirm="REVOGAR {{ client.hostname }}?&#10;&#10;O computador para de receber o wallpaper e passa a aparecer como Revogado. Para voltar, será preciso reinstalar o agente (Reinstalar no Ativa Updater).&#10;&#10;Use apenas para computadores desativados ou comprometidos."
                      title="Revogar cliente (bloqueia o computador até ser reinstalado)"><i class="ti ti-ban"></i></button>
            {% endif %}
          </span>
        </td>
      </tr>
    {% else %}
      <tr><td colspan="8" class="awp-table-empty">
        {% if summary.managed == 0 %}
          Nenhum computador registrado. Os computadores aparecem aqui depois que o AtivaWallpaperClient é instalado.
        {% else %}
          Nenhum computador encontrado com esses filtros.
        {% endif %}
      </td></tr>
    {% endfor %}
    </tbody>
  </table>
</div>
<div class="awp-table-footer">
  <span class="text-muted">Mostrando {{ clients.total }} registro(s)</span>
  {% if clients.pages > 1 %}
    <nav class="awp-pagination" aria-label="Páginas de computadores">
      {% if clients.page > 1 %}
        <a href="{{ urls.dashboard }}?{{ query|merge({page: clients.page - 1})|url_encode }}#awp-computers">Anterior</a>
      {% else %}
        <span class="is-disabled">Anterior</span>
      {% endif %}
      {% for number in max(1, clients.page - 2)..min(clients.pages, clients.page + 2) %}
        {% if number == clients.page %}
          <span class="is-current" aria-current="page">{{ number }}</span>
        {% else %}
          <a href="{{ urls.dashboard }}?{{ query|merge({page: number})|url_encode }}#awp-computers">{{ number }}</a>
        {% endif %}
      {% endfor %}
      {% if clients.page < clients.pages %}
        <a href="{{ urls.dashboard }}?{{ query|merge({page: clients.page + 1})|url_encode }}#awp-computers">Próxima</a>
      {% else %}
        <span class="is-disabled">Próxima</span>
      {% endif %}
    </nav>
  {% else %}
    <nav class="awp-pagination" aria-label="Páginas de computadores">
      <span class="is-disabled">Anterior</span><span class="is-current" aria-current="page">1</span><span class="is-disabled">Próxima</span>
    </nav>
  {% endif %}
</div>
