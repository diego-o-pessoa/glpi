<div class="row">
    <div class="col-12">
        {% if not updater_active %}
            <div class="alert alert-warning">
                <i class="ti ti-alert-triangle"></i>
                O plugin <strong>Ativa Updater</strong> precisa estar ativo: é o serviço dele que instala o RustDesk e registra os computadores.
            </div>
        {% endif %}
        {% if default_password and can_configure %}
            <div class="alert alert-warning">
                <i class="ti ti-key"></i>
                A senha do T.I. para computadores protegidos ainda é a padrão.
                <a href="{{ urls.config }}">Altere em Configurações</a>.
            </div>
        {% endif %}
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><i class="ti ti-device-desktop-share me-2"></i>Computadores com Ativa Remote</h3>
                {% if can_configure %}
                    <a href="{{ urls.config }}" class="btn btn-sm btn-outline-secondary"><i class="ti ti-settings"></i> Configurações</a>
                {% endif %}
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">
                    Os computadores aparecem aqui depois de instalar o pacote unificado 1.6.8 ou superior (que traz o serviço Ativa Updater 1.7.1 e o RustDesk).
                    "Solicitar acesso" gera uma senha nova no RustDesk, válida até a sessão ser encerrada (no máximo 4 horas).
                </p>
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Computador</th>
                                <th>Situação</th>
                                <th>RustDesk</th>
                                <th>Último contato</th>
                                <th>Acesso</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for client in clients.rows %}
                            {% set status = client.remote_access_status %}
                            <tr>
                                <td>
                                    {% if client.computers_id %}
                                        <a href="{{ urls.computer }}?id={{ client.computers_id }}"><strong>{{ client.hostname }}</strong></a>
                                    {% else %}
                                        <strong>{{ client.hostname }}</strong>
                                    {% endif %}
                                    {% if client.protected %}
                                        <span class="badge bg-purple-lt ms-1" title="{{ client.protection_reason }}: sempre pede autorização e exige a senha do T.I.">
                                            <i class="ti ti-shield-lock"></i> Protegido
                                        </span>
                                    {% endif %}
                                    <div class="small text-muted">Serviço {{ client.client_version ?: '—' }}</div>
                                    {% if not client.computers_id %}
                                        <div class="small text-warning" title="O nome do computador não corresponde a um único computador do inventário; a proteção por grupo não se aplica.">
                                            Sem vínculo com o inventário
                                        </div>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if client.online %}
                                        <span class="badge bg-success">Online</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Offline</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if client.rustdesk_id %}
                                        <code>{{ client.rustdesk_id }}</code>
                                        <div class="small text-muted">{{ client.rustdesk_version ? 'v' ~ client.rustdesk_version : '' }}</div>
                                    {% else %}
                                        <span class="text-warning">Não pronto</span>
                                    {% endif %}
                                    {% if client.rustdesk_message %}
                                        <div class="small text-muted">{{ client.rustdesk_message }}</div>
                                    {% endif %}
                                </td>
                                <td>{{ client.last_check ? client.last_check|formatted_datetime : '—' }}</td>
                                <td>
                                    {% if status == 'pending' %}
                                        <span class="badge bg-warning"><i class="ti ti-loader-2"></i> Aguardando</span>
                                    {% elseif status == 'accepted' %}
                                        <span class="badge bg-success">Liberado</span>
                                    {% elseif status == 'closing' %}
                                        <span class="badge bg-secondary">Encerrando</span>
                                    {% elseif status == 'rejected' %}
                                        <span class="badge bg-danger">Recusado</span>
                                    {% elseif status == 'failed' %}
                                        <span class="badge bg-danger">Falhou</span>
                                    {% else %}
                                        <span class="badge {{ client.require_consent ? 'bg-primary' : 'bg-secondary' }}">
                                            {{ client.protected ? 'Sempre pede autorização' : (client.require_consent ? 'Pede autorização' : 'Acesso sem autorização') }}
                                        </span>
                                    {% endif %}
                                    {% if client.status_message %}
                                        <div class="small text-muted">{{ client.status_message }}</div>
                                    {% endif %}
                                    {% if status == 'accepted' and client.password %}
                                        <div class="mt-1 small">
                                            ID <code>{{ client.rustdesk_id }}</code> · Senha <code>{{ client.password }}</code>
                                        </div>
                                    {% endif %}
                                </td>
                                <td class="text-end text-nowrap">
                                    {% if can_manage %}
                                        {% if client.can_connect and client.protected %}
                                            <button type="button" class="btn btn-sm btn-success" data-ativa-protected-connect
                                                    data-id="{{ client.id }}" data-hostname="{{ client.hostname }}" data-verified="{{ client.ti_verified ? '1' : '0' }}"
                                                    title="{{ client.ti_verified ? 'Senha do T.I. já conferida para esta sessão' : 'Exige a senha do T.I.' }}">
                                                <i class="ti ti-lock"></i> Conectar
                                            </button>
                                        {% elseif client.can_connect and client.connect_url %}
                                            <a href="{{ client.connect_url }}" class="btn btn-sm btn-success" data-ativa-connect
                                               data-rustdesk-id="{{ client.rustdesk_id }}" data-password="{{ client.password }}">
                                                <i class="ti ti-device-desktop"></i> Conectar
                                            </a>
                                        {% endif %}
                                        {% if status in ['pending', 'accepted'] %}
                                            <form method="post" action="{{ urls.action }}" class="d-inline-block">
                                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                                <input type="hidden" name="action" value="close_remote_access">
                                                <input type="hidden" name="id" value="{{ client.id }}">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Encerrar e trocar a senha">
                                                    <i class="ti ti-x"></i> {{ status == 'pending' ? 'Cancelar' : 'Encerrar' }}
                                                </button>
                                            </form>
                                        {% elseif status != 'closing' and client.protected %}
                                            <button type="button" class="btn btn-sm btn-primary" data-ativa-protected-request
                                                    data-id="{{ client.id }}" data-hostname="{{ client.hostname }}"
                                                    {{ client.online and client.rustdesk_id ? '' : 'disabled' }}
                                                    title="{{ client.online ? (client.rustdesk_id ? 'Exige a senha do T.I.' : 'RustDesk ainda não está pronto') : 'Computador offline' }}">
                                                <i class="ti ti-lock"></i> Solicitar acesso
                                            </button>
                                        {% elseif status != 'closing' %}
                                            <form method="post" action="{{ urls.action }}" class="d-inline-block">
                                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                                <input type="hidden" name="action" value="request_remote_access">
                                                <input type="hidden" name="id" value="{{ client.id }}">
                                                <button type="submit" class="btn btn-sm btn-primary"
                                                        {{ client.online and client.rustdesk_id ? '' : 'disabled' }}
                                                        title="{{ client.online ? (client.rustdesk_id ? 'Solicitar acesso remoto' : 'RustDesk ainda não está pronto') : 'Computador offline' }}">
                                                    <i class="ti ti-hand-click"></i> Solicitar acesso
                                                </button>
                                            </form>
                                        {% endif %}
                                        {% if status is null and client.protected %}
                                            <span class="btn btn-sm btn-outline-secondary disabled" title="Grupo protegido: a autorização não pode ser desligada">
                                                <i class="ti ti-lock"></i> Autorização: obrigatória
                                            </span>
                                        {% elseif status is null %}
                                            <form method="post" action="{{ urls.action }}" class="d-inline-block"
                                                  data-ativa-confirm="{{ client.require_consent ? 'Permitir acesso a este computador sem a autorização do usuário?' : 'Voltar a pedir a autorização do usuário?' }}">
                                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                                <input type="hidden" name="action" value="toggle_rustdesk_consent">
                                                <input type="hidden" name="id" value="{{ client.id }}">
                                                <input type="hidden" name="require" value="{{ client.require_consent ? '0' : '1' }}">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Alterar a exigência de autorização">
                                                    <i class="ti ti-key"></i> Autorização: {{ client.require_consent ? 'ON' : 'OFF' }}
                                                </button>
                                            </form>
                                        {% elseif status in ['rejected', 'failed'] %}
                                            <form method="post" action="{{ urls.action }}" class="d-inline-block">
                                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                                <input type="hidden" name="action" value="close_remote_access">
                                                <input type="hidden" name="id" value="{{ client.id }}">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Limpar o resultado">
                                                    <i class="ti ti-eraser"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                    {% else %}
                                        <small class="text-muted">Somente leitura</small>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="text-center text-muted">Nenhum computador registrado ainda.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center">
                <span class="text-muted">{{ clients.total }} computador(es)</span>
                {% if clients.pages > 1 %}
                    <div class="btn-group">
                        {% if clients.page > 1 %}
                            <a class="btn btn-sm btn-outline-secondary" href="{{ urls.dashboard }}?page={{ clients.page - 1 }}&limit={{ clients.limit }}">Anterior</a>
                        {% endif %}
                        <span class="btn btn-sm disabled">{{ clients.page }} / {{ clients.pages }}</span>
                        {% if clients.page < clients.pages %}
                            <a class="btn btn-sm btn-outline-secondary" href="{{ urls.dashboard }}?page={{ clients.page + 1 }}&limit={{ clients.limit }}">Próxima</a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
<form method="post" action="{{ urls.action }}" class="d-none" data-ti-request-form>
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="action" value="request_remote_access">
    <input type="hidden" name="id" value="">
    <input type="hidden" name="ti_password" value="">
</form>
<div class="modal fade" id="ativa-remote-ti-password" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <form class="modal-content" data-ti-password-form data-endpoint="{{ urls.connect }}" autocomplete="off">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-shield-lock me-2"></i>Computador protegido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Informe a senha do T.I. para <span data-ti-purpose>conectar em</span> <strong data-ti-hostname></strong>.</p>
                <input type="hidden" name="id" data-ti-id>
                <input class="form-control" type="password" name="ti_password" required autocomplete="off"
                       placeholder="Senha do T.I." data-ti-password>
                <div class="text-danger small mt-2 d-none" data-ti-error></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-success" data-ti-submit><i class="ti ti-check"></i> Continuar</button>
            </div>
        </form>
    </div>
</div>
<div class="modal fade" id="ativa-remote-connect" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ti ti-device-desktop me-2"></i>Conectar pelo RustDesk</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">
                    O navegador deve perguntar se pode abrir o <strong>RustDesk</strong>; confirme para conectar.
                    Se nada abrir, abra o RustDesk neste computador e informe os dados abaixo.
                </p>
                <label class="form-label mb-1">ID</label>
                <div class="input-group mb-2">
                    <input class="form-control font-monospace" readonly data-connect-field="id">
                    <button class="btn btn-outline-secondary" type="button" data-copy-field="id"><i class="ti ti-copy"></i> Copiar</button>
                </div>
                <label class="form-label mb-1">Senha</label>
                <div class="input-group">
                    <input class="form-control font-monospace" readonly data-connect-field="password">
                    <button class="btn btn-outline-secondary" type="button" data-copy-field="password"><i class="ti ti-copy"></i> Copiar</button>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-success" data-connect-retry href="#"><i class="ti ti-external-link"></i> Abrir o RustDesk novamente</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>
<script>
    (() => {
        // Faster while waiting for a computer; otherwise refresh the online status every 30 s.
        // A reload closes the browser's "Open RustDesk?" prompt, so it waits while a connection is being opened.
        let pausedUntil = 0;
        const reload = () => {
            if (Date.now() < pausedUntil || document.querySelector('#ativa-remote-connect.show, #ativa-remote-ti-password.show')) {
                setTimeout(reload, 5000);
            } else if (document.visibilityState === 'visible') {
                window.location.reload();
            } else {
                document.addEventListener('visibilitychange', reload, { once: true });
            }
        };
        setTimeout(reload, {{ waiting ? 5000 : 30000 }});

        const dialog = document.getElementById('ativa-remote-connect');
        const openRustdesk = (url) => {
            pausedUntil = Date.now() + 60000;
            window.location.href = url;
        };
        const showConnection = (rustdeskId, password, url) => {
            dialog.querySelector('[data-connect-field="id"]').value = rustdeskId;
            dialog.querySelector('[data-connect-field="password"]').value = password;
            dialog.querySelector('[data-connect-retry]').setAttribute('href', url);
            bootstrap.Modal.getOrCreateInstance(dialog).show();
            openRustdesk(url);
        };
        // The session password of a protected computer must not stay in the page.
        dialog.addEventListener('hidden.bs.modal', () => {
            dialog.querySelectorAll('[data-connect-field]').forEach((input) => { input.value = ''; });
            dialog.querySelector('[data-connect-retry]').setAttribute('href', '#');
        });
        document.querySelectorAll('[data-ativa-connect]').forEach((link) => {
            link.addEventListener('click', (event) => {
                event.preventDefault();
                showConnection(link.dataset.rustdeskId, link.dataset.password, link.getAttribute('href'));
            });
        });

        const tiDialog = document.getElementById('ativa-remote-ti-password');
        const tiForm = tiDialog.querySelector('[data-ti-password-form]');
        const tiError = tiDialog.querySelector('[data-ti-error]');
        const tiSubmit = tiDialog.querySelector('[data-ti-submit]');
        const tiPassword = tiDialog.querySelector('[data-ti-password]');
        const requestForm = document.querySelector('[data-ti-request-form]');
        const askPassword = (button, mode, message = '') => {
            tiForm.dataset.mode = mode;
            tiDialog.querySelector('[data-ti-id]').value = button.dataset.id;
            tiDialog.querySelector('[data-ti-hostname]').textContent = button.dataset.hostname;
            tiDialog.querySelector('[data-ti-purpose]').textContent = mode === 'request' ? 'solicitar acesso a' : 'conectar em';
            tiPassword.value = '';
            tiError.textContent = message;
            tiError.classList.toggle('d-none', message === '');
            bootstrap.Modal.getOrCreateInstance(tiDialog).show();
        };
        document.querySelectorAll('[data-ativa-protected-request]').forEach((button) => {
            button.addEventListener('click', () => askPassword(button, 'request'));
        });
        const connectProtected = async (id, password) => {
            const body = new FormData();
            body.append('id', id);
            body.append('ti_password', password);
            const response = await fetch(tiForm.dataset.endpoint, {
                method: 'POST',
                body,
                credentials: 'same-origin',
                headers: {
                    Accept: 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'X-Glpi-Csrf-Token': document.querySelector('meta[property="glpi:csrf_token"]')?.getAttribute('content') || '',
                },
            });
            return response.json().catch(() => ({ ok: false, message: `Erro ${response.status} ao liberar a conexão.` }));
        };
        document.querySelectorAll('[data-ativa-protected-connect]').forEach((button) => {
            button.addEventListener('click', async () => {
                if (button.dataset.verified !== '1') {
                    askPassword(button, 'connect');
                    return;
                }
                button.disabled = true;
                try {
                    const result = await connectProtected(button.dataset.id, '');
                    if (result.ok) {
                        showConnection(result.rustdesk_id, result.password, result.connect_url);
                    } else {
                        askPassword(button, 'connect', result.password_required ? '' : (result.message || ''));
                    }
                } catch (error) {
                    askPassword(button, 'connect', 'Falha de comunicação com o GLPI. Tente novamente.');
                } finally {
                    button.disabled = false;
                }
            });
        });
        tiDialog.addEventListener('shown.bs.modal', () => tiPassword.focus());
        tiDialog.addEventListener('hidden.bs.modal', () => { tiPassword.value = ''; });
        tiForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (tiForm.dataset.mode === 'request') {
                // Regular POST: the page reloads with the result of the request.
                requestForm.querySelector('[name="id"]').value = tiDialog.querySelector('[data-ti-id]').value;
                requestForm.querySelector('[name="ti_password"]').value = tiPassword.value;
                tiSubmit.disabled = true;
                requestForm.submit();
                return;
            }
            tiSubmit.disabled = true;
            tiError.classList.add('d-none');
            try {
                const result = await connectProtected(tiDialog.querySelector('[data-ti-id]').value, tiPassword.value);
                if (!result.ok) {
                    tiError.textContent = result.message || 'Não foi possível liberar a conexão.';
                    tiError.classList.remove('d-none');
                    tiPassword.focus();
                    return;
                }
                bootstrap.Modal.getOrCreateInstance(tiDialog).hide();
                showConnection(result.rustdesk_id, result.password, result.connect_url);
            } catch (error) {
                tiError.textContent = 'Falha de comunicação com o GLPI. Tente novamente.';
                tiError.classList.remove('d-none');
            } finally {
                tiSubmit.disabled = false;
                tiPassword.value = '';
            }
        });
        dialog.querySelector('[data-connect-retry]').addEventListener('click', (event) => {
            event.preventDefault();
            openRustdesk(event.currentTarget.getAttribute('href'));
        });
        dialog.querySelectorAll('[data-copy-field]').forEach((button) => {
            button.addEventListener('click', () => {
                const input = dialog.querySelector(`[data-connect-field="${button.dataset.copyField}"]`);
                input.select();
                const done = () => {
                    button.innerHTML = '<i class="ti ti-check"></i> Copiado';
                    setTimeout(() => { button.innerHTML = '<i class="ti ti-copy"></i> Copiar'; }, 2000);
                };
                if (navigator.clipboard) {
                    navigator.clipboard.writeText(input.value).then(done, () => { document.execCommand('copy'); done(); });
                } else {
                    document.execCommand('copy');
                    done();
                }
            });
        });
        document.querySelectorAll('form[data-ativa-confirm]').forEach((form) => {
            form.addEventListener('submit', (event) => {
                if (!window.confirm(form.dataset.ativaConfirm)) {
                    event.preventDefault();
                }
            });
        });
    })();
</script>
